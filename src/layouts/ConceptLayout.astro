---
import '../styles/philosophy-family.css';
import '../styles/concept.css';
import PhilosophyHeader from '../components/philosophy/PhilosophyHeader.astro';
import PhilosophyFooter from '../components/philosophy/PhilosophyFooter.astro';
import ModelVisual from '../components/philosophy/ModelVisual.astro';
import { writtenModels, findWrittenModelByTitleOrIdx } from '../data/philosophy-family';

const { frontmatter } = Astro.props;
const fm = frontmatter ?? {};

const pageHref = (href: string) => {
  if (!href || typeof href !== 'string') return href;
  if (href === '/' || href.startsWith('#') || /^(https?:|mailto:|tel:)/.test(href)) return href;
  const [pathAndQuery, hash] = href.split('#');
  const [path, query] = pathAndQuery.split('?');
  const last = path.split('/').pop() ?? '';
  const htmlPath = /\.[a-z0-9]+$/i.test(last) || path.endsWith('/') ? path : `${path}.html`;
  return `${htmlPath}${query ? `?${query}` : ''}${hash ? `#${hash}` : ''}`;
};

const kind = (fm.kind ?? 'model').toLowerCase();
const kindLabel =
  ({ principle: 'Principle', model: 'Model', tool: 'Tool', path: 'Path', system: 'System', doctrine: 'Principle' } as Record<string, string>)[kind] ??
  'Model';

const idx = fm.idx ?? '';
const domain = fm.domain ?? fm.category ?? '';
const chain = fm.chain ?? '';
const consequence = fm.consequence ?? fm.description ?? '';
const changes = fm.changes ?? fm.purpose ?? '';

const flow = Array.isArray(fm.flow) ? fm.flow : [];
const claims = Array.isArray(fm.claims) ? fm.claims : [];
const distinctions = Array.isArray(fm.distinctions) ? fm.distinctions : [];
const lenses = Array.isArray(fm.lenses) ? fm.lenses : [];
const experiment = fm.experiment ?? null;

const graphRows = [
  ['Builds on', fm.buildsOn],
  ['Connects to', fm.connectsTo ?? fm.relatedModels],
  ['Challenges', fm.challenges],
  ['Leads to', fm.leadsTo],
].filter(([, v]) => Array.isArray(v) && v.length);

const currentModel = findWrittenModelByTitleOrIdx(fm.title, fm.idx);
const currentIdx = currentModel ? writtenModels.findIndex((m) => m.slug === currentModel.slug) : -1;
const prevModel = currentIdx > 0 ? writtenModels[currentIdx - 1] : null;
const nextModel = currentIdx >= 0 && currentIdx < writtenModels.length - 1 ? writtenModels[currentIdx + 1] : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fm.title} — ICY CLEAR</title>
    <meta name="description" content={fm.description || consequence} />
    <meta name="theme-color" content="#070c10" />
    <meta property="og:title" content={`${fm.title} — ICY CLEAR`} />
    <meta property="og:description" content={fm.description || consequence} />
    <meta property="og:type" content="article" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/clear/fonts/bodoni.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/clear/fonts/bodoni-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/clear/fonts/barlow.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/clear/fonts/plex-mono.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body class="ph-doc">
    <a class="ph-skip" href="#main">Skip to model</a>

    <PhilosophyHeader active="model" currentModelSlug={currentModel?.slug} />

    <!-- Five-Model Direct Lens Switcher -->
    <nav class="cx-rail" aria-label="Switch between the five written models">
      <div class="cx-rail__inner">
        {writtenModels.map((model) => (
          <a
            class:list={['cx-rail__item', { 'is-current': currentModel?.slug === model.slug }]}
            href={model.href}
            aria-current={currentModel?.slug === model.slug ? 'page' : undefined}
          >
            <small>{model.idx}</small>
            <span>{model.shortTitle}</span>
          </a>
        ))}
      </div>
    </nav>

    <main id="main" class="cx-main" tabindex="-1">
      <!-- Opening -->
      <section class="cx-entry" aria-labelledby="concept-title">
        <div class="cx-entry__meta">
          {idx && <span>{idx}</span>}
          <span>{kindLabel}</span>
          {domain && <span>{domain}</span>}
          {fm.status && <span>{fm.status}</span>}
        </div>

        <h1 id="concept-title" class="cx-entry__title">{fm.title}</h1>
        {chain && <p class="cx-entry__chain">{chain}</p>}
        {consequence && <p class="cx-entry__consequence">“{consequence}”</p>}

        {changes && (
          <div class="cx-entry__changes">
            <span class="cx-section-label">What shifts when you look this way</span>
            <p>{changes}</p>
          </div>
        )}

        <!-- Bespoke Interactive Conceptual Visualization for the 5 Core Models -->
        {currentModel && <ModelVisual slug={currentModel.slug} />}
      </section>

      <!-- Process / Mechanism Flow -->
      {flow.length > 0 && (
        <section class="cx-band" aria-label="Sequence">
          <div class="cx-band__grid">
            <span class="cx-section-label">The Sequence</span>
            <div class="cx-flow" data-flow>
              {flow.map((s: any, i: number) => (
                <button
                  class:list={['cx-flow__stage', { 'is-open': i === 0 }]}
                  type="button"
                  data-stage
                  aria-expanded={i === 0 ? 'true' : 'false'}
                >
                  <span class="cx-flow__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="cx-flow__name">{s.label}</span>
                  <span class="cx-flow__cue" aria-hidden="true">{s.note ? '+' : ''}</span>
                  {s.note && <p class="cx-flow__note">{s.note}</p>}
                </button>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Distinctions -->
      {distinctions.length > 0 && (
        <section class="cx-band" aria-label="Usually confused">
          <div class="cx-band__grid">
            <span class="cx-section-label">Usually Confused</span>
            <div class="cx-dist">
              {distinctions.map((d: any) => (
                <div class="cx-dist__row">
                  <div class="cx-dist__cell">
                    <span>{d.a}</span>
                    <p>{d.aNote}</p>
                  </div>
                  <div class="cx-dist__cell cx-dist__cell--b">
                    <span>{d.b}</span>
                    <p>{d.bNote}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Thought Experiment -->
      {experiment && (
        <section class="cx-band" aria-label="Thought experiment">
          <div class="cx-band__grid">
            <span class="cx-section-label">Test It Directly</span>
            <div class="cx-exp" data-exp>
              {experiment.situation && <p class="cx-exp__situation">{experiment.situation}</p>}
              {experiment.ask && <p class="cx-exp__ask">{experiment.ask}</p>}
              <button class="cx-exp__btn" type="button" aria-expanded="false">Reveal the distinction</button>
              <div class="cx-exp__reveal">
                {(experiment.reveal ?? []).map((r: string) => <p>{r}</p>)}
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Epistemic Standing (keeps claims honest — never invents certainty) -->
      {claims.length > 0 && (
        <section class="cx-band" aria-label="Standing of claims">
          <div class="cx-band__grid">
            <span class="cx-section-label">Epistemic Standing</span>
            <ul class="cx-claims">
              {claims.map((c: any) => (
                <li>
                  <span class={`cx-ev cx-ev--${(c.tag ?? 'inferred').toLowerCase()}`}>{c.tag ?? 'Inferred'}</span>
                  <p>{c.text}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Inquiry Lenses -->
      {lenses.length > 0 && (
        <section class="cx-band" aria-label="Lenses">
          <div class="cx-band__grid">
            <span class="cx-section-label">Questions to Hold</span>
            <ul class="cx-lenses" data-lenses>
              {lenses.map((l: any, i: number) => (
                <li class:list={['cx-lens', { 'is-open': i === 0 }]}>
                  <button class="cx-lens__btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                    <span class="cx-lens__name">{l.name}</span>
                    <span class="cx-lens__sign" aria-hidden="true">{i === 0 ? '−' : '+'}</span>
                  </button>
                  <div class="cx-lens__body">
                    {l.prompt && <p class="cx-lens__prompt">{l.prompt}</p>}
                    {l.body && <p class="cx-lens__read">{l.body}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Original Written Essay (<slot />) -->
      <section class="cx-band" aria-label="Written essay">
        <div class="cx-band__grid">
          <span class="cx-section-label">Full Notes</span>
          <div class="cx-essay">
            <slot />
          </div>
        </div>
      </section>

      <!-- Position in the Inquiry Graph -->
      {graphRows.length > 0 && (
        <section class="cx-band" aria-label="Connections">
          <div class="cx-band__grid">
            <span class="cx-section-label">In the Inquiry</span>
            <ul class="cx-graph">
              {graphRows.map(([rowLabel, items]: any) => (
                <li>
                  <span class="cx-graph__label">{rowLabel}</span>
                  <div class="cx-graph__links">
                    {items.map((it: any) =>
                      it.href ? <a href={pageHref(it.href)}>{it.title}</a> : <span>{it.title}</span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Seamless Progression across the 5 Models + Frameworks -->
      <nav class="cx-pager" aria-label="Continue through the philosophy family">
        {prevModel ? (
          <a class="cx-pager__card" href={prevModel.href}>
            <span>← Previous Lens · {prevModel.idx}</span>
            <strong>{prevModel.title}</strong>
            <small>{prevModel.line}</small>
          </a>
        ) : (
          <a class="cx-pager__card" href="/clear.html">
            <span>← Personal Philosophy</span>
            <strong>ICY CLEAR · How I See It</strong>
            <small>Life as Continuous Development (01–06)</small>
          </a>
        )}

        {nextModel ? (
          <a class="cx-pager__card cx-pager__card--next" href={nextModel.href}>
            <span>Next Lens · {nextModel.idx} →</span>
            <strong>{nextModel.title}</strong>
            <small>{nextModel.line}</small>
          </a>
        ) : (
          <a class="cx-pager__card cx-pager__card--next" href="/generative-reality.html">
            <span>Companion Framework →</span>
            <strong>Generative Reality</strong>
            <small>Six transitions from perception to new possibility</small>
          </a>
        )}
      </nav>
    </main>

    <PhilosophyFooter active="model" currentModelSlug={currentModel?.slug} />

    <script src="../scripts/model-visuals.ts"></script>
  </body>
</html>
