---
// Bespoke interactive visual explanations for each of the 5 core Written Models.
// Every visual directly demonstrates the conceptual distinction of that model
// without claiming scientific certainty or using decorative fluff.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

{slug === 'seeing-before-naming' && (
  <div class="mv-plate" data-mv="seeing-before-naming" data-stage="contact">
    <div class="mv-bar">
      <span class="ph-mono mv-kicker">INTERACTIVE STUDY · EVENT VS. LABEL</span>
      <div class="mv-controls" role="group" aria-label="Change observation layer">
        <button type="button" class="mv-btn is-active" data-sbn-mode="contact" aria-pressed="true">01 Raw Contact</button>
        <button type="button" class="mv-btn" data-sbn-mode="perceived" aria-pressed="false">02 Perceived Form</button>
        <button type="button" class="mv-btn" data-sbn-mode="labeled" aria-pressed="false">03 Apply Label</button>
      </div>
    </div>

    <div class="mv-stage">
      <svg class="mv-svg" viewBox="0 0 620 248" fill="none" role="img" aria-label="Interactive diagram showing rich sensory details fading when a premature word label is stamped over an event">
        <!-- Fine layered event contours (full richness in Contact & Perceived, flattened under Label) -->
        <g class="sbn-details">
          <path d="M56 154 C96 72, 194 64, 266 124 C338 184, 424 188, 558 84" stroke="#9dcfe4" stroke-width="1.6" />
          <path d="M68 176 C126 98, 212 88, 286 138 C362 190, 444 176, 548 112" stroke="#a8d5c2" stroke-opacity="0.72" stroke-width="1.2" />
          <path d="M84 126 C158 58, 244 82, 316 146 C388 208, 476 164, 536 134" stroke="#e4ba75" stroke-opacity="0.58" stroke-width="1.1" stroke-dasharray="4 4" />
          <circle cx="164" cy="96" r="18" stroke="#9dcfe4" stroke-opacity="0.45" />
          <circle cx="298" cy="144" r="34" stroke="#a8d5c2" stroke-opacity="0.35" stroke-dasharray="2 4" />
          <circle cx="436" cy="152" r="22" stroke="#e4ba75" stroke-opacity="0.42" />
          <circle cx="212" cy="108" r="3.2" fill="#9dcfe4" />
          <circle cx="298" cy="144" r="3.2" fill="#a8d5c2" />
          <circle cx="384" cy="166" r="3.2" fill="#e4ba75" />
          <circle cx="476" cy="134" r="3.2" fill="#9dcfe4" />
          <line x1="164" y1="96" x2="298" y2="144" stroke="rgba(157,207,228,0.28)" />
          <line x1="298" y1="144" x2="436" y2="152" stroke="rgba(168,213,194,0.28)" />
          <text x="58" y="42" fill="#7c9aa5" font-family="ClearMono, monospace" font-size="9">LIGHT · DURATION · RELATION · MOTION</text>
        </g>

        <!-- Structure guides appearing in Perceived Form -->
        <g class="sbn-structure">
          <line x1="110" y1="208" x2="510" y2="208" stroke="rgba(157,207,228,0.34)" />
          <line x1="164" y1="96" x2="164" y2="208" stroke="rgba(157,207,228,0.28)" stroke-dasharray="3 3" />
          <line x1="298" y1="144" x2="298" y2="208" stroke="rgba(157,207,228,0.28)" stroke-dasharray="3 3" />
          <line x1="436" y1="152" x2="436" y2="208" stroke="rgba(157,207,228,0.28)" stroke-dasharray="3 3" />
          <text x="164" y="226" text-anchor="middle" fill="#9dcfe4" font-family="ClearMono, monospace" font-size="8.5">EDGE A</text>
          <text x="298" y="226" text-anchor="middle" fill="#9dcfe4" font-family="ClearMono, monospace" font-size="8.5">INFLECTION</text>
          <text x="436" y="226" text-anchor="middle" fill="#9dcfe4" font-family="ClearMono, monospace" font-size="8.5">EDGE B</text>
        </g>

        <!-- Premature label stamp that collapses observation -->
        <g class="sbn-stamp">
          <rect x="196" y="72" width="228" height="104" fill="rgba(7,12,16,0.88)" stroke="#e4ba75" stroke-width="1.6" />
          <text x="310" y="114" text-anchor="middle" fill="#e4ba75" font-family="ClearMono, monospace" font-size="9.5" letter-spacing="2">FILE CLOSED · LABEL</text>
          <text x="310" y="148" text-anchor="middle" fill="#eee9de" font-family="BodoniClear, Georgia, serif" font-size="34">“Avoidance”</text>
        </g>
      </svg>

      <p class="mv-caption" data-sbn-caption aria-live="polite">
        Before naming: light, contour, interval, and relation remain intact. Nothing has been reduced to a verdict yet.
      </p>
    </div>
  </div>
)}

{slug === 'replace-stories-with-systems' && (
  <div class="mv-plate" data-mv="replace-stories-with-systems" data-mode="story">
    <div class="mv-bar">
      <span class="ph-mono mv-kicker">INTERACTIVE STUDY · STORY VEIL → MECHANISM</span>
      <div class="mv-controls" role="group" aria-label="Switch between story, system, and leverage point">
        <button type="button" class="mv-btn is-active" data-sys-mode="story" aria-pressed="true">01 The Story</button>
        <button type="button" class="mv-btn" data-sys-mode="system" aria-pressed="false">02 Expose System</button>
        <button type="button" class="mv-btn" data-sys-mode="leverage" aria-pressed="false">03 Move 1 Constraint</button>
      </div>
    </div>

    <div class="mv-stage">
      <svg class="mv-svg" viewBox="0 0 620 252" fill="none" role="img" aria-label="Interactive diagram contrasting an opaque personal story with an editable feedback system">
        <!-- Underlying Mechanism Loop (revealed in system & leverage modes) -->
        <g class="sys-diagram">
          <!-- Loop connectors -->
          <path class="sys-edge sys-edge-hot" d="M168 92 L244 92" stroke="#e4ba75" stroke-width="1.6" />
          <path class="sys-edge sys-edge-hot" d="M376 92 L450 92" stroke="#e4ba75" stroke-width="1.6" />
          <path class="sys-edge sys-edge-hot" d="M518 124 C518 188, 396 196, 310 196" stroke="#e4ba75" stroke-width="1.5" stroke-dasharray="4 4" />
          <path class="sys-edge sys-edge-feedback" d="M310 196 C210 196, 102 188, 102 124" stroke="#df886a" stroke-width="1.6" stroke-dasharray="4 4" />

          <!-- Nodes -->
          <rect class="sys-node-constraint" x="34" y="60" width="134" height="64" fill="#0d1820" stroke="#9dcfe4" stroke-width="1.3" />
          <text x="101" y="84" text-anchor="middle" fill="#9dcfe4" font-family="ClearMono, monospace" font-size="8.5">CONSTRAINT / TRIGGER</text>
          <text class="sys-trigger-txt" x="101" y="106" text-anchor="middle" fill="#eee9de" font-family="BodoniClear, Georgia, serif" font-size="18">Too many inputs</text>

          <rect x="244" y="60" width="132" height="64" fill="#0d1820" stroke="#a8c6cc" stroke-opacity="0.55" />
          <text x="310" y="84" text-anchor="middle" fill="#98a9aa" font-family="ClearMono, monospace" font-size="8.5">PROCESS</text>
          <text class="sys-proc-txt" x="310" y="106" text-anchor="middle" fill="#eee9de" font-family="BodoniClear, Georgia, serif" font-size="18">Attention splits</text>

          <rect x="450" y="60" width="136" height="64" fill="#0d1820" stroke="#e4ba75" stroke-opacity="0.7" />
          <text x="518" y="84" text-anchor="middle" fill="#e4ba75" font-family="ClearMono, monospace" font-size="8.5">OUTCOME</text>
          <text class="sys-out-txt" x="518" y="106" text-anchor="middle" fill="#eee9de" font-family="BodoniClear, Georgia, serif" font-size="18">Repeated error</text>

          <!-- Feedback badge -->
          <rect x="206" y="178" width="208" height="36" fill="#0b141b" stroke="rgba(223,136,106,0.55)" />
          <text class="sys-fb-txt" x="310" y="200" text-anchor="middle" fill="#df886a" font-family="ClearMono, monospace" font-size="9">FEEDBACK: FRUSTRATION → MORE INPUTS</text>
        </g>

        <!-- Opaque Story Veil (blocks all leverage handles in story mode) -->
        <g class="sys-story-veil">
          <rect x="46" y="34" width="528" height="184" fill="rgba(7,12,16,0.95)" stroke="rgba(168,198,204,0.32)" />
          <text x="310" y="86" text-anchor="middle" fill="#98a9aa" font-family="ClearMono, monospace" font-size="9.5" letter-spacing="2">IDENTITY STORY · NO MOVABLE VARIABLES</text>
          <text x="310" y="132" text-anchor="middle" fill="#eee9de" font-family="BodoniClear, Georgia, serif" font-style="italic" font-size="34">“I keep messing things up.”</text>
          <text x="310" y="172" text-anchor="middle" fill="#677a7d" font-family="ClearMono, monospace" font-size="9">FEELS COMPLETE · OFFERS ZERO LEVERAGE</text>
        </g>
      </svg>

      <p class="mv-caption" data-sys-caption aria-live="polite">
        A story feels emotionally complete, yet leaves you nothing to test or move. Expose the system underneath to find the variable.
      </p>
    </div>
  </div>
)}

{slug === 'from-reaction-to-pattern' && (
  <div class="mv-plate" data-mv="from-reaction-to-pattern" data-window="1">
    <div class="mv-bar">
      <span class="ph-mono mv-kicker">INTERACTIVE STUDY · FRAME VS. TRAJECTORY</span>
      <div class="mv-controls" role="group" aria-label="Widen temporal observation window">
        <button type="button" class="mv-btn is-active" data-pat-win="1" aria-pressed="true">01 Single Frame</button>
        <button type="button" class="mv-btn" data-pat-win="4" aria-pressed="false">02 Four Frames</button>
        <button type="button" class="mv-btn" data-pat-win="12" aria-pressed="false">03 Full Trajectory</button>
      </div>
    </div>

    <div class="mv-stage">
      <svg class="mv-svg" viewBox="0 0 620 248" fill="none" role="img" aria-label="Interactive time-window visualization widening from one alarming spike to a steady recurring pattern">
        <!-- Horizontal guide ticks -->
        <line x1="28" y1="196" x2="592" y2="196" stroke="rgba(168,198,204,0.18)" />
        <line x1="28" y1="126" x2="592" y2="126" stroke="rgba(168,198,204,0.1)" stroke-dasharray="3 4" />
        <line x1="28" y1="56" x2="592" y2="56" stroke="rgba(168,198,204,0.1)" stroke-dasharray="3 4" />

        <!-- Full 12-frame signal + trajectory slope -->
        <path class="pat-slope" d="M44 166 L576 82" stroke="#a8d5c2" stroke-width="1.6" stroke-dasharray="6 4" />
        <path
          class="pat-series"
          d="M44 162 L92 174 L140 144 L188 158 L236 128 L284 148 L332 70 L380 124 L428 104 L476 112 L524 88 L576 80"
          stroke="#9dcfe4"
          stroke-width="2"
          stroke-linejoin="round"
        />

        <!-- Individual frame markers (the loud spike sits at x=332) -->
        {[
          [44, 162], [92, 174], [140, 144], [188, 158], [236, 128], [284, 148],
          [332, 70], [380, 124], [428, 104], [476, 112], [524, 88], [576, 80],
        ].map(([cx, cy], idx) => (
          <circle
            cx={cx}
            cy={cy}
            r={idx === 6 ? 5.5 : 3.5}
            fill={idx === 6 ? '#e4ba75' : '#9dcfe4'}
          />
        ))}

        <!-- Masking curtains that narrow/widen the observer's time aperture -->
        <rect class="pat-curtain pat-curtain-left" x="0" y="20" width="292" height="196" fill="rgba(7,12,16,0.9)" />
        <rect class="pat-curtain pat-curtain-right" x="372" y="20" width="248" height="196" fill="rgba(7,12,16,0.9)" />
        <rect class="pat-frame-box" x="292" y="28" width="80" height="182" stroke="#e4ba75" stroke-width="1.4" />
        <text class="pat-label" x="332" y="232" text-anchor="middle" fill="#e4ba75" font-family="ClearMono, monospace" font-size="9.5" letter-spacing="1.4">
          1 FRAME · ISOLATED SPIKE FEELS LIKE THE WHOLE TRUTH
        </text>
      </svg>

      <p class="mv-caption" data-pat-caption aria-live="polite">
        Inside a single frame, one sharp drop or spike looks dramatic and permanent. Widen the window before adding meaning.
      </p>
    </div>
  </div>
)}

{slug === 'coherence-vs-entropy' && (
  <div class="mv-plate" data-mv="coherence-vs-entropy" data-scenario="coherence">
    <div class="mv-bar">
      <span class="ph-mono mv-kicker">INTERACTIVE STUDY · SURFACE TONE VS. SYSTEM DIRECTION</span>
      <div class="mv-controls" role="group" aria-label="Compare coherent action and entropic avoidance">
        <button type="button" class="mv-btn is-active" data-coh-mode="coherence" aria-pressed="true">Direct Truth (Coherent)</button>
        <button type="button" class="mv-btn" data-coh-mode="entropy" aria-pressed="false">Smooth Avoidance (Entropy)</button>
      </div>
    </div>

    <div class="mv-stage">
      <svg class="mv-svg" viewBox="0 0 620 248" fill="none" role="img" aria-label="Vector filament field comparing uncomfortable truth leading to aligned coherence against smooth avoidance leading to entropic drift">
        <!-- Event contact vertical plane -->
        <line x1="210" y1="24" x2="210" y2="214" stroke="rgba(228,186,117,0.45)" stroke-dasharray="3 4" />
        <text x="108" y="34" text-anchor="middle" fill="#677a7d" font-family="ClearMono, monospace" font-size="8.5">BEFORE ACTION</text>
        <text x="210" y="232" text-anchor="middle" fill="#e4ba75" font-family="ClearMono, monospace" font-size="8.5">MOMENT OF CONTACT</text>
        <text x="414" y="34" text-anchor="middle" fill="#98a9aa" font-family="ClearMono, monospace" font-size="8.5">WHAT HAPPENS AFTERWARDS</text>

        <!-- Coherent path: brief rough ripple at x=210, then crisp aligned parallel tracks -->
        <g class="coh-set coh-aligned">
          <path d="M36 96 C110 112, 165 66, 210 108 C242 132, 268 78, 326 84 L584 84" stroke="#a8d5c2" stroke-width="1.7" />
          <path d="M36 122 C112 104, 164 150, 210 116 C244 92, 270 128, 326 118 L584 118" stroke="#9dcfe4" stroke-width="1.7" />
          <path d="M36 148 C114 164, 166 130, 210 156 C246 176, 272 146, 326 152 L584 152" stroke="#a8d5c2" stroke-width="1.7" />
          <path d="M36 174 C118 158, 168 186, 210 168 C248 152, 274 188, 326 186 L584 186" stroke="#9dcfe4" stroke-opacity="0.7" stroke-width="1.4" />
          <text x="580" y="66" text-anchor="end" fill="#a8d5c2" font-family="ClearMono, monospace" font-size="9">NEXT STEP CLEARER · LOWER REPAIR COST</text>
        </g>

        <!-- Entropic path: smooth calm line at x=210, then gradual scatter and drift -->
        <g class="coh-set coh-drift">
          <path d="M36 118 L210 118 C288 118, 344 74, 422 52 C486 34, 534 78, 584 44" stroke="#df9d73" stroke-width="1.6" />
          <path d="M36 130 L210 130 C294 130, 356 154, 434 114 C498 82, 536 156, 584 136" stroke="#e4ba75" stroke-width="1.6" stroke-dasharray="5 3" />
          <path d="M36 142 L210 142 C290 142, 346 118, 418 174 C484 222, 534 176, 584 204" stroke="#df886a" stroke-width="1.6" />
          <path d="M36 154 L210 154 C280 154, 340 198, 436 196 C508 194, 540 128, 584 166" stroke="#98a9aa" stroke-opacity="0.65" stroke-width="1.3" stroke-dasharray="3 4" />
          <text x="580" y="218" text-anchor="end" fill="#df886a" font-family="ClearMono, monospace" font-size="9">NEXT STEP MURKIER · DRIFT COMPOUNDS</text>
        </g>
      </svg>

      <p class="mv-caption" data-coh-caption aria-live="polite">
        Uncomfortable at contact, coherent afterwards: confusion clears and the next step takes less energy to coordinate.
      </p>
    </div>
  </div>
)}

{slug === 'clear-again' && (
  <div class="mv-plate" data-mv="clear-again" data-strategy="return">
    <div class="mv-bar">
      <span class="ph-mono mv-kicker">INTERACTIVE STUDY · SHORTENING THE RETURN INTERVAL</span>
      <div class="mv-controls" role="group" aria-label="Compare holding clarity vs practicing the return">
        <button type="button" class="mv-btn" data-ca-mode="hold" aria-pressed="false">Try to Hold Clarity</button>
        <button type="button" class="mv-btn is-active" data-ca-mode="return" aria-pressed="true">Practice Returning</button>
        <button type="button" class="mv-btn mv-btn--pulse" data-ca-pulse>Add Pressure Pulse</button>
      </div>
    </div>

    <div class="mv-stage">
      <svg class="mv-svg" viewBox="0 0 620 248" fill="none" role="img" aria-label="Waveform showing honest drift under pressure returning to baseline over progressively shorter intervals">
        <!-- Clear baseline -->
        <line x1="28" y1="128" x2="592" y2="128" stroke="rgba(168,213,194,0.34)" stroke-dasharray="4 4" />
        <text x="32" y="118" fill="#a8d5c2" font-family="ClearMono, monospace" font-size="8.5">CLEAR BASELINE</text>

        <!-- Pressure markers -->
        <line x1="112" y1="36" x2="112" y2="212" stroke="rgba(228,186,117,0.22)" />
        <line x1="298" y1="36" x2="298" y2="212" stroke="rgba(228,186,117,0.22)" />
        <line x1="462" y1="36" x2="462" y2="212" stroke="rgba(228,186,117,0.22)" />
        <text x="112" y="28" text-anchor="middle" fill="#e4ba75" font-family="ClearMono, monospace" font-size="8">PRESSURE 1</text>
        <text x="298" y="28" text-anchor="middle" fill="#e4ba75" font-family="ClearMono, monospace" font-size="8">PRESSURE 2</text>
        <text x="462" y="28" text-anchor="middle" fill="#e4ba75" font-family="ClearMono, monospace" font-size="8">PRESSURE 3</text>

        <!-- Dynamic trajectory path rendered cleanly by script + solid SSR initial path -->
        <path
          data-ca-path
          d="M28 128 L112 128 C126 52, 166 196, 224 128 L298 128 C310 74, 342 164, 384 128 L462 128 C472 96, 492 146, 514 128 L592 128"
          stroke="#98c7b8"
          stroke-width="2.1"
          stroke-linecap="round"
        />

        <!-- Return interval brackets -->
        <g data-ca-brackets>
          <line x1="112" y1="214" x2="224" y2="214" stroke="#98c7b8" stroke-width="1.3" />
          <text x="168" y="232" text-anchor="middle" fill="#98a9aa" font-family="ClearMono, monospace" font-size="8.5">LONG RETURN</text>
          <line x1="298" y1="214" x2="384" y2="214" stroke="#98c7b8" stroke-width="1.3" />
          <text x="341" y="232" text-anchor="middle" fill="#98a9aa" font-family="ClearMono, monospace" font-size="8.5">SHORTER</text>
          <line x1="462" y1="214" x2="514" y2="214" stroke="#e4ba75" stroke-width="1.5" />
          <text x="488" y="232" text-anchor="middle" fill="#e4ba75" font-family="ClearMono, monospace" font-size="8.5">QUICK RETURN</text>
        </g>
      </svg>

      <p class="mv-caption" data-ca-caption aria-live="polite">
        Drift still arrives under pressure — nobody stays permanently clear. Noticing sooner shortens the route back: drift → notice → adjust → return.
      </p>
    </div>
  </div>
)}
