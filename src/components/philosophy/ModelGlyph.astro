---
// Bespoke miniature conceptual emblem for each of the 5 core Written Models.
// Gives each lens an unmistakable visual signature across the homepage, ICY CLEAR,
// Generative Reality, and the model pages themselves.
interface Props {
  slug: string;
  accent?: string;
}

const { slug, accent = '#9dcfe4' } = Astro.props;
---

{slug === 'seeing-before-naming' ? (
  <svg class="model-glyph" viewBox="0 0 88 52" fill="none" aria-hidden="true">
    <!-- Organic perceived contour behind an angular naming bracket -->
    <path d="M12 28 C18 11, 35 10, 44 26 C53 41, 68 38, 76 22" stroke={accent} stroke-width="1.35" stroke-linecap="round" />
    <path d="M16 34 C26 20, 38 18, 48 28 C58 37, 67 32, 74 26" stroke={accent} stroke-opacity="0.4" stroke-width="1" stroke-dasharray="2.5 3" />
    <rect x="30" y="13" width="28" height="26" stroke="#e4ba75" stroke-opacity="0.65" stroke-width="1" stroke-dasharray="3 2.5" />
    <circle cx="44" cy="26" r="2.8" fill={accent} />
  </svg>
) : slug === 'replace-stories-with-systems' ? (
  <svg class="model-glyph" viewBox="0 0 88 52" fill="none" aria-hidden="true">
    <!-- Coupled actors, constraints, incentives & feedback loop -->
    <circle cx="24" cy="26" r="10.5" stroke={accent} stroke-width="1.3" />
    <circle cx="64" cy="26" r="10.5" stroke={accent} stroke-width="1.3" stroke-opacity="0.72" />
    <path d="M33 20 C42 13, 46 13, 55 20" stroke="#9dcfe4" stroke-width="1.2" />
    <path d="M55 32 C46 39, 42 39, 33 32" stroke={accent} stroke-width="1.2" stroke-dasharray="3 2.5" />
    <circle cx="24" cy="26" r="2.5" fill={accent} />
    <circle cx="64" cy="26" r="2.5" fill="#9dcfe4" />
  </svg>
) : slug === 'from-reaction-to-pattern' ? (
  <svg class="model-glyph" viewBox="0 0 88 52" fill="none" aria-hidden="true">
    <!-- Four isolated frames resolving into a clear rising trajectory -->
    <rect x="8" y="28" width="12" height="14" stroke={accent} stroke-opacity="0.4" stroke-width="1" />
    <rect x="27" y="23" width="12" height="14" stroke={accent} stroke-opacity="0.6" stroke-width="1" />
    <rect x="46" y="17" width="12" height="14" stroke={accent} stroke-opacity="0.8" stroke-width="1" />
    <rect x="65" y="10" width="12" height="14" stroke={accent} stroke-width="1.25" />
    <path d="M14 35 L33 30 L52 24 L71 17" stroke="#e4ba75" stroke-width="1.35" stroke-linecap="round" />
    <circle cx="71" cy="17" r="2.6" fill="#e4ba75" />
  </svg>
) : slug === 'coherence-vs-entropy' ? (
  <svg class="model-glyph" viewBox="0 0 88 52" fill="none" aria-hidden="true">
    <!-- Left aligned coherent flow vs right scattering drift -->
    <line x1="10" y1="16" x2="42" y2="16" stroke={accent} stroke-width="1.3" />
    <line x1="10" y1="26" x2="42" y2="26" stroke={accent} stroke-width="1.3" />
    <line x1="10" y1="36" x2="42" y2="36" stroke={accent} stroke-width="1.3" />
    <path d="M46 16 Q60 14, 78 9" stroke={accent} stroke-opacity="0.62" stroke-width="1.1" stroke-dasharray="3 2.5" />
    <path d="M46 26 Q62 29, 78 24" stroke="#e4ba75" stroke-opacity="0.72" stroke-width="1.1" stroke-dasharray="3 2.5" />
    <path d="M46 36 Q61 38, 78 44" stroke={accent} stroke-opacity="0.52" stroke-width="1.1" stroke-dasharray="3 2.5" />
    <line x1="44" y1="10" x2="44" y2="42" stroke="rgba(238,233,222,0.22)" stroke-width="1" />
  </svg>
) : (
  <svg class="model-glyph" viewBox="0 0 88 52" fill="none" aria-hidden="true">
    <!-- Clear Again: damped wave returning to clear centerline on shorter intervals -->
    <line x1="8" y1="26" x2="80" y2="26" stroke="rgba(238,233,222,0.25)" stroke-width="1" stroke-dasharray="2 3" />
    <path d="M8 26 C15 8, 22 44, 32 26 C38 14, 44 37, 52 26 C57 19, 62 32, 69 26 C73 23, 76 28, 80 26" stroke={accent} stroke-width="1.45" stroke-linecap="round" />
    <circle cx="80" cy="26" r="2.7" fill="#e4ba75" />
  </svg>
)}
