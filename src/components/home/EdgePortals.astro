---
// EdgePortals — renders portal links at viewport edges/corners
// Positions are assigned automatically based on index

import PortalLink from "./PortalLink.astro";

interface Props {
  items: import('../../data/home').MediaItem[];
}

const { items } = Astro.props;

const positions: Array<'corner-tl' | 'corner-tr' | 'corner-bl' | 'corner-br' | 'edge-t' | 'edge-r' | 'edge-b' | 'edge-l'> = [
  'corner-tl', 'corner-tr', 'corner-bl', 'corner-br',
  'edge-t', 'edge-r', 'edge-b', 'edge-l',
];
---

<style is:global>
  .edge-portals {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    overflow: hidden;
  }
  .edge-portals > * {
    pointer-events: auto;
  }

  @media (max-width: 640px) {
    .edge-portals {
      position: static;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
      padding: 0;
      pointer-events: auto;
    }
  }
</style>

<div class="edge-portals" aria-label="External portals" role="navigation">
  {items.map((item, index) => (
    <PortalLink
      item={item}
      position={positions[index % positions.length]}
    />
  ))}
</div>