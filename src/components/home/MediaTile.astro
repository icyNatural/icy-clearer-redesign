---
// MediaTile — reusable media primitive for homepage composition
// Supports: image, video, project, link types
// NON-INTERACTIVE BY DEFAULT: renders as a link only when the manifest
// item has an explicit `href`. Placeholders never navigate.

import type { SlotSize } from '../../data/home';

interface Props {
  item: import('../../data/home').MediaItem;
  slotSize?: SlotSize;
  class?: string;
}

const { item, slotSize = 'feature', class: className = '' } = Astro.props;
const { type, src, poster, alt, label, href, external, accent = '#cfe7ff' } = item;

const isVideo = type === 'video';
const isInteractive = !!href;
const Tag = isInteractive ? 'a' : 'figure';
const mediaClass = `media-tile media-tile--${slotSize} media-tile--${type} ${className}`;

const style = `--accent: ${accent};`;
---

<style is:global>
  .media-tile {
    --accent: #cfe7ff;
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #0a0f1a;
    border: 1px solid rgba(207, 231, 255, 0.12);
    text-decoration: none;
    color: inherit;
    contain: layout style;
  }
  .media-tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);
  }
  .media-tile:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .media-tile__media {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    overflow: hidden;
  }
  .media-tile__media img,
  .media-tile__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
  }
  .media-tile:hover .media-tile__media img,
  .media-tile:hover .media-tile__media video {
    transform: scale(1.04);
  }
  .media-tile--video .media-tile__media video {
    background: #000;
  }

  .media-tile__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(10px, 2vw, 20px);
    background: linear-gradient(180deg, transparent 40%, rgba(6, 9, 15, 0.85) 100%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .media-tile:hover .media-tile__overlay,
  .media-tile:focus-visible .media-tile__overlay {
    opacity: 1;
  }
  .media-tile--role-hero .media-tile__overlay,
  .media-tile--role-portal .media-tile__overlay {
    opacity: 1;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: linear-gradient(180deg, rgba(6, 9, 15, 0.5), rgba(6, 9, 15, 0.9));
  }

  .media-tile__label {
    font-family: "IM FELL English", "EB Garamond", serif;
    font-size: clamp(1.25rem, 3vw, 2.25rem);
    font-weight: 400;
    line-height: 1.1;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6);
  }
  .media-tile--thumb .media-tile__label {
    font-size: clamp(0.95rem, 2vw, 1.4rem);
  }
  .media-tile--portal .media-tile__label {
    font-size: clamp(1.1rem, 2.5vw, 1.75rem);
  }

  .media-tile__meta {
    margin-top: 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(207, 231, 255, 0.7);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .media-tile__meta::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .media-tile__glyph {
    position: absolute;
    top: clamp(12px, 2vw, 20px);
    right: clamp(12px, 2vw, 20px);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(207, 231, 255, 0.22);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(207, 231, 255, 0.12), transparent 70%);
    color: var(--accent);
    font-size: 1.25rem;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .media-tile:hover .media-tile__glyph,
  .media-tile:focus-visible .media-tile__glyph {
    opacity: 1;
    transform: scale(1);
  }
  .media-tile--role-portal .media-tile__glyph {
    opacity: 1;
    transform: scale(1);
    position: static;
    margin: 0 auto 12px;
    width: 64px;
    height: 64px;
    font-size: 1.75rem;
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 65%);
  }

  .media-tile__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .media-tile--video:hover .media-tile__play,
  .media-tile--video:focus-visible .media-tile__play {
    opacity: 1;
  }
  .media-tile__play svg {
    width: 64px;
    height: 64px;
    color: #fff;
    filter: drop-shadow(0 4px 24px rgba(0, 0, 0, 0.5));
    stroke-width: 2.5;
  }

  .media-tile--hero-wide { aspect-ratio: 16 / 9; }
  .media-tile--wide {
    aspect-ratio: 16 / 9;
  }
  .media-tile--square {
    aspect-ratio: 1 / 1;
  }
  .media-tile--portrait {
    aspect-ratio: 3 / 4;
  }
  .media-tile--tall {
    aspect-ratio: 9 / 16;
  }
  .media-tile--compact {
    aspect-ratio: 4 / 3;
  }
  .media-tile--feature {
    aspect-ratio: 4 / 3;
  }

  /* Placeholder state */
  .media-tile--placeholder {
    background: linear-gradient(135deg, #0d1422 0%, #0a0f1a 100%);
    border-style: dashed;
    border-color: rgba(207, 231, 255, 0.18);
  }
  .media-tile--placeholder .media-tile__media {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: rgba(207, 231, 255, 0.45);
  }
  .media-tile--placeholder .media-tile__media svg {
    width: 48px;
    height: 48px;
    stroke: currentColor;
  }
  .media-tile--placeholder .media-tile__label {
    color: rgba(207, 231, 255, 0.55);
  }
  .media-tile--placeholder .media-tile__meta::before {
    background: rgba(207, 231, 255, 0.45);
    box-shadow: 0 0 10px rgba(207, 231, 255, 0.45);
  }

  /* Portal-specific center layout for social portals when used inline */
  .media-tile--portal-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .media-tile--portal-center .media-tile__overlay {
    opacity: 1;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: linear-gradient(180deg, rgba(6, 9, 15, 0.5), rgba(6, 9, 15, 0.9));
  }
  .media-tile--portal-center .media-tile__label {
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
  }
  .media-tile--portal-center .media-tile__glyph {
    opacity: 1;
    transform: scale(1);
    position: static;
    margin: 0 auto 12px;
    width: 64px;
    height: 64px;
    font-size: 1.75rem;
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 65%);
  }

  @media (prefers-reduced-motion: reduce) {
    .media-tile__media img,
    .media-tile__media video {
      transition: none;
    }
    .media-tile:hover .media-tile__media img,
    .media-tile:hover .media-tile__media video {
      transform: none;
    }
    .media-tile__overlay,
    .media-tile__glyph {
      transition: none;
    }
  }
</style>

<Tag
  class={mediaClass}
  style={style}
  href={isInteractive ? href : undefined}
  target={isInteractive && external ? '_blank' : undefined}
  rel={isInteractive && external ? 'noopener' : undefined}
  aria-label={isInteractive ? (label || alt) : undefined}
>
  <div class="media-tile__media" aria-hidden="true">
    {isVideo ? (
      <video
        muted
        playsinline
        preload="metadata"
        loop
        poster={poster || src}
        aria-hidden="true"
      >
        <source src={src} type="video/mp4" />
      </video>
    ) : (
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    )}
  </div>

  {isVideo && (
    <div class="media-tile__play" aria-hidden="true">
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="1.5" fill="rgba(0,0,0,0.3)" />
        <polygon points="26,22 26,42 44,32" fill="currentColor" />
      </svg>
    </div>
  )}

  <div class="media-tile__overlay">
    <span class="media-tile__label">{label || ''}</span>
    {label && <span class="media-tile__meta" aria-hidden="true"></span>}
  </div>

  {item.id && !item.src?.startsWith('http') && (
    <span class="media-tile__glyph" aria-hidden="true">{item.glyph || '✦'}</span>
  )}
</Tag>

<script>
  // Muted autoplay for video tiles when in viewport (skipped under reduced motion)
  if (typeof IntersectionObserver !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const videoTiles = document.querySelectorAll('.media-tile--video video');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target;
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    }, { rootMargin: '100px', threshold: 0.1 });
    videoTiles.forEach((v) => observer.observe(v));
  }
</script>