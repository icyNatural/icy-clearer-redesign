---
// IdentityBlock — strong visual identity anchor at top of homepage
// Purely presentational, driven by content manifest

interface Props {
  identity: import('../../data/home').IdentityConfig;
}

const { mark, title, subtitle, accent, background } = Astro.props.identity;
---

<style is:global>
  .identity-block {
    --accent: #cfe7ff;
    position: relative;
    isolation: isolate;
    padding: clamp(28px, 5vw, 64px) clamp(18px, 5vw, 80px) clamp(22px, 4vw, 48px);
    display: grid;
    place-items: start center;
    text-align: center;
    overflow: hidden;
  }
  .identity-block::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 50% 30%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 55%),
      radial-gradient(ellipse at 80% 80%, color-mix(in srgb, var(--accent) 6%, transparent), transparent 45%),
      #06090f;
  }
  .identity-block__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.18;
    object-fit: cover;
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 80%, transparent);
  }

  .identity-block__mark {
    display: inline-grid;
    place-items: center;
    width: clamp(48px, 7vw, 76px);
    height: clamp(48px, 7vw, 76px);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 14%, transparent), transparent 65%);
    color: var(--accent);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    box-shadow:
      0 0 40px color-mix(in srgb, var(--accent) 20%, transparent),
      inset 0 0 30px color-mix(in srgb, var(--accent) 10%, transparent);
    animation: mark-breathe 6s ease-in-out infinite;
  }
  @keyframes mark-breathe {
    0%, 100% { transform: scale(1); box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 20%, transparent), inset 0 0 30px color-mix(in srgb, var(--accent) 10%, transparent); }
    50% { transform: scale(1.03); box-shadow: 0 0 60px color-mix(in srgb, var(--accent) 30%, transparent), inset 0 0 40px color-mix(in srgb, var(--accent) 18%, transparent); }
  }

  .identity-block__title {
    margin: clamp(12px, 2vw, 20px) 0 clamp(6px, 1vw, 10px);
    font-family: "IM FELL English", "EB Garamond", serif;
    font-size: clamp(2.35rem, 6vw, 5.25rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.035em;
    color: #fff;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.5);
  }

  .identity-block__subtitle {
    margin: 0;
    max-width: 48ch;
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(0.6rem, 1.1vw, 0.75rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(207, 231, 255, 0.68);
  }

  .identity-block__accent-line {
    margin-top: clamp(14px, 2vw, 24px);
    width: clamp(60px, 12vw, 140px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    box-shadow: 0 0 20px var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .identity-block__mark { animation: none; }
  }
</style>

<header class="identity-block" style={`--accent: ${accent};`} role="banner">
  {background && <img class="identity-block__bg" src={background} alt="" aria-hidden="true" />}
  <span class="identity-block__mark" aria-hidden="true">{mark}</span>
  <h1 class="identity-block__title">{title}</h1>
  <p class="identity-block__subtitle">{subtitle}</p>
  <div class="identity-block__accent-line" aria-hidden="true"></div>
</header>