---
// Drop — generic media primitive for the homepage.
// NON-INTERACTIVE BY DEFAULT. Renders as a link only when the manifest
// entry has an explicit `href`. Images view/focus only. Videos play/focus.
// Placeholders never navigate.

import type { Drop as DropData } from '../../data/home';

interface Props {
  drop: DropData;
  index?: number;
}

const { drop, index = 0 } = Astro.props;
const {
  type,
  src,
  poster,
  alt,
  label,
  href,
  external,
  role = 'field',
  shape = 'wide',
  world = 'shared',
  motion = 'still',
  accent = '#cfe7ff',
  glyph,
} = drop;

const isVideo = type === 'video';
const isLink = Boolean(href);
const Tag = isLink ? 'a' : 'figure';

const classes = [
  'drop',
  `drop--${shape}`,
  `drop--role-${role}`,
  `drop--${world}`,
  `drop--motion-${motion}`,
  isLink ? 'drop--linked' : 'drop--still-frame',
  isVideo ? 'drop--video' : '',
].filter(Boolean).join(' ');

const style = `--accent: ${accent}; --i: ${index};`;
---

<Tag
  class={classes}
  style={style}
  data-drop={drop.id}
  data-motion={motion}
  data-world={world}
  data-depth={motion === 'parallax' ? (world === 'natural' ? '8' : '14') : undefined}
  href={isLink ? href : undefined}
  target={isLink && external ? '_blank' : undefined}
  rel={isLink && external ? 'noopener' : undefined}
  aria-label={isLink ? (label || alt) : undefined}
>
  <div class="drop__media" data-parallax-media>
    {isVideo ? (
      <video
        muted
        playsinline
        preload="metadata"
        loop
        poster={poster || src}
        aria-hidden="true"
      >
        <source src={src} type="video/mp4" />
      </video>
    ) : (
      <img src={src} alt={alt} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
    )}
  </div>

  <div class="drop__veil" aria-hidden="true"></div>

  {isVideo && (
    <button
      class="drop__play"
      type="button"
      aria-label={`Play ${label || alt}`}
      aria-pressed="false"
      data-video-toggle
    >
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="32" cy="32" r="28" stroke-width="1.5" fill="rgba(0,0,0,0.28)" />
        <polygon class="drop__play-icon" points="26,22 26,42 44,32" fill="currentColor" />
      </svg>
    </button>
  )}

  <figcaption class="drop__caption">
    {glyph && <span class="drop__glyph" aria-hidden="true">{glyph}</span>}
    {label && <span class="drop__label">{label}</span>}
    {isLink && <span class="drop__cue" aria-hidden="true">{external ? '↗' : '→'}</span>}
  </figcaption>
</Tag>

<style is:global>
  .drop {
    --accent: #cfe7ff;
    --i: 0;
    position: relative;
    display: block;
    margin: 0;
    min-width: 0;
    isolation: isolate;
    overflow: hidden;
    background: #081018;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    transform: translateZ(0);
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.55s ease,
      opacity 0.7s ease;
  }
  .drop--linked { cursor: pointer; }
  .drop:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .drop__media {
    position: absolute;
    inset: -4%;
    z-index: 0;
  }
  .drop__media img,
  .drop__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.5s ease;
    will-change: transform;
  }
  .drop:hover .drop__media img,
  .drop:hover .drop__media video,
  .drop:focus-within .drop__media img,
  .drop:focus-within .drop__media video {
    transform: scale(1.05);
    filter: saturate(1.12) brightness(1.05);
  }

  /* world grading — atmosphere bleeds into every drop */
  .drop--clearer .drop__media { background: radial-gradient(120% 90% at 30% 10%, #12304e, #07101c 70%); }
  .drop--natural .drop__media { background: radial-gradient(120% 90% at 70% 20%, #1c3320, #0a140c 70%); }
  .drop--shared .drop__media { background: linear-gradient(115deg, #0d2438 0%, #0a140c 100%); }

  .drop__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(6, 9, 15, 0) 45%, rgba(6, 9, 15, 0.78) 100%),
      linear-gradient(90deg, rgba(6, 9, 15, 0.22), transparent 40%);
    transition: opacity 0.4s ease;
  }
  .drop--natural .drop__veil {
    background:
      linear-gradient(180deg, rgba(8, 14, 9, 0) 42%, rgba(8, 14, 9, 0.8) 100%),
      linear-gradient(270deg, rgba(8, 14, 9, 0.2), transparent 40%);
  }
  .drop:hover .drop__veil,
  .drop:focus-within .drop__veil { opacity: 0.85; }

  .drop__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: clamp(10px, 2vw, 18px);
    margin: 0;
    pointer-events: none;
  }

  .drop__glyph {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: clamp(22px, 2.4vw, 30px);
    height: clamp(22px, 2.4vw, 30px);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 50%;
    background: rgba(6, 9, 15, 0.45);
    color: var(--accent);
    font-size: clamp(0.65rem, 1vw, 0.8rem);
    line-height: 1;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    margin-bottom: 2px;
  }

  .drop__label {
    font-family: "IM FELL English", "EB Garamond", serif;
    font-size: clamp(1.05rem, 2.4vw, 1.7rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.65);
    min-width: 0;
  }

  .drop__cue {
    margin-left: auto;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .drop--linked:hover .drop__cue,
  .drop--linked:focus-visible .drop__cue {
    opacity: 1;
    transform: none;
  }

  /* ── shapes ── */
  .drop--hero-wide { aspect-ratio: 16 / 10; }
  .drop--panoramic { aspect-ratio: 21 / 9; }
  .drop--wide { aspect-ratio: 16 / 10; }
  .drop--square { aspect-ratio: 1 / 1; }
  .drop--portrait { aspect-ratio: 3 / 4; }
  .drop--tall { aspect-ratio: 9 / 14; }
  .drop--compact { aspect-ratio: 4 / 3; }

  /* ── roles ── */
  .drop--role-hero {
    border-radius: 2px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.45);
  }
  .drop--role-hero .drop__label {
    font-size: clamp(1.9rem, 5.5vw, 4.4rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    max-width: 12ch;
  }
  .drop--role-hero .drop__veil {
    background:
      linear-gradient(100deg, rgba(6, 9, 15, 0.55) 0%, rgba(6, 9, 15, 0.1) 45%, rgba(6, 9, 15, 0.65) 100%),
      linear-gradient(180deg, transparent 40%, rgba(6, 9, 15, 0.82) 100%);
  }

  .drop--role-fragment {
    border-radius: 999px 6px 96px 6px;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.4);
  }
  .drop--role-fragment .drop__caption {
    padding-right: clamp(28px, 7vw, 56px);
    padding-bottom: clamp(14px, 2.5vw, 22px);
  }
  .drop--role-fragment .drop__label {
    font-size: clamp(1.15rem, 2.6vw, 1.9rem);
    font-style: italic;
  }

  .drop--role-signal {
    border-radius: 2px;
    outline: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    outline-offset: -1px;
  }
  .drop--role-signal:hover,
  .drop--role-signal:focus-within {
    outline-color: var(--accent);
  }

  .drop--role-quiet {
    border-radius: 2px;
    filter: saturate(0.85);
  }
  .drop--role-quiet .drop__label {
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    color: rgba(255, 255, 255, 0.92);
  }

  .drop--role-strip {
    border-radius: 2px;
  }

  /* ── motion behaviors ── */
  .drop--motion-drift .drop__media img,
  .drop--motion-drift .drop__media video {
    animation: drop-drift 14s ease-in-out infinite;
    animation-delay: calc(var(--i) * -3.2s);
  }
  @keyframes drop-drift {
    0%, 100% { transform: scale(1.06) translate3d(-0.6%, -0.4%, 0); }
    50% { transform: scale(1.1) translate3d(0.8%, 0.6%, 0); }
  }
  .drop--motion-drift:hover .drop__media img,
  .drop--motion-drift:hover .drop__media video {
    animation-play-state: paused;
  }

  .drop--motion-drag {
    touch-action: pan-y;
    cursor: grab;
  }
  .drop--motion-drag.is-dragging {
    cursor: grabbing;
    z-index: 30;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.55);
    transition: none;
  }
  .drop--motion-drag .drop__media {
    transition: transform 0.05s linear;
  }

  /* pointer depth */
  @media (pointer: fine) {
    .drop--motion-parallax .drop__media img {
      transform: scale(1.08) translate3d(calc(var(--px, 0) * 10px), calc(var(--py, 0) * 7px), 0);
    }
    .drop--motion-parallax:hover .drop__media img,
    .drop--motion-parallax:focus-within .drop__media img {
      transform: scale(1.12) translate3d(calc(var(--px, 0) * 14px), calc(var(--py, 0) * 10px), 0);
    }
  }

  /* reveal */
  .js .drop {
    opacity: 0;
    transform: translateY(18px) scale(0.985);
  }
  .js .drop.is-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .drop,
    .drop__media img,
    .drop__media video {
      transition: none !important;
      animation: none !important;
    }
    .js .drop {
      opacity: 1;
      transform: none;
    }
    .drop--motion-parallax .drop__media img {
      transform: scale(1.04);
    }
  }
</style>
