---
// WorldPortal — compact doorway into /world.html (the systems map).

import { homeContent } from '../../data/home';

const { worldPortal } = homeContent;
---

<style is:global>
  .world-portal {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 200px;
    overflow: hidden;
    border-radius: 3px;
    text-decoration: none;
    color: #f4f9ff;
    isolation: isolate;
    background: #071018;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }
  .world-portal:hover,
  .world-portal:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5), 0 0 60px rgba(127, 203, 255, 0.1);
  }
  .world-portal:focus-visible {
    outline: 2px solid #9fd9ff;
    outline-offset: 3px;
  }

  .world-portal__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .world-portal__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 47%;
    transform: scale(2.1);
    transform-origin: 50% 47%;
    filter: saturate(1.15) brightness(0.95);
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1), filter 0.5s ease;
  }
  .world-portal:hover .world-portal__media img,
  .world-portal:focus-visible .world-portal__media img {
    transform: scale(2.28);
    filter: saturate(1.3) brightness(1.08);
  }

  .world-portal__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(7, 16, 28, 0.2), rgba(6, 10, 16, 0.85)),
      radial-gradient(ellipse at 50% 30%, rgba(127, 203, 255, 0.14), transparent 60%);
  }

  .world-portal__content {
    position: relative;
    z-index: 2;
    height: 100%;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    padding: clamp(16px, 2.6vw, 24px);
  }

  .world-portal__eyebrow {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.5rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(191, 228, 255, 0.65);
  }

  .world-portal__title {
    margin: 0;
    font-family: "IM FELL English", "EB Garamond", serif;
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 0.95;
    text-shadow: 0 3px 28px rgba(0, 0, 0, 0.6);
  }

  .world-portal__desc {
    margin: 2px 0 10px;
    max-width: 34ch;
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(0.52rem, 0.9vw, 0.62rem);
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(220, 236, 248, 0.55);
  }

  .world-portal__enter {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 18px;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.55rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    border-radius: 999px;
    border: 1px solid rgba(191, 228, 255, 0.45);
    color: #eaf6ff;
    background: rgba(6, 9, 15, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .world-portal:hover .world-portal__enter,
  .world-portal:focus-visible .world-portal__enter {
    background: rgba(127, 203, 255, 0.14);
    border-color: #bfe4ff;
  }

  .world-portal__glyph {
    position: absolute;
    top: clamp(12px, 2vw, 18px);
    right: clamp(12px, 2vw, 18px);
    z-index: 2;
    display: grid;
    place-items: center;
    width: clamp(32px, 3.6vw, 42px);
    height: clamp(32px, 3.6vw, 42px);
    border-radius: 50%;
    border: 1px solid rgba(191, 228, 255, 0.4);
    background: rgba(6, 9, 15, 0.4);
    color: #bfe4ff;
    font-size: clamp(0.9rem, 1.5vw, 1.15rem);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .world-portal,
    .world-portal__media img { transition: none; }
    .world-portal:hover { transform: none; }
  }
</style>

<a class="world-portal" href={worldPortal.href} aria-label={`Enter ${worldPortal.title} — ${worldPortal.description}`}>
  <div class="world-portal__media" aria-hidden="true">
    <img src={worldPortal.image} alt="" loading="lazy" decoding="async" />
  </div>
  <div class="world-portal__veil" aria-hidden="true"></div>
  <span class="world-portal__glyph" aria-hidden="true">{worldPortal.glyph}</span>
  <div class="world-portal__content">
    <span class="world-portal__eyebrow">{worldPortal.eyebrow}</span>
    <h2 class="world-portal__title">{worldPortal.title}</h2>
    <p class="world-portal__desc">{worldPortal.description}</p>
    <span class="world-portal__enter" aria-hidden="true">Enter →</span>
  </div>
</a>
