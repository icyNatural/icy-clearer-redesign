---
// HeroCollision — full-bleed entry where the two worlds meet.
// Giant typography integrated into environment · symbolic center → Two Worlds.

import { homeContent } from '../../data/home';

const { identity, doors } = homeContent;
const clearDoor = doors.find((d) => d.world === 'clearer');
const naturalDoor = doors.find((d) => d.world === 'natural');
---

<style is:global>
  .hero-collision {
    --seam: 52%;
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: clamp(520px, 86svh, 980px);
    overflow: hidden;
    display: grid;
    place-items: center;
    background: #06090f;
  }

  /* environmental bed — the split image, graded and masked */
  .hero-collision__bed {
    position: absolute;
    inset: -6%;
    z-index: 0;
  }
  .hero-collision__bed img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.62;
    filter: saturate(1.15) contrast(1.05);
    mask-image: linear-gradient(180deg, #000 0%, #000 68%, transparent 100%);
    transform: scale(1.06) translate3d(calc(var(--px, 0) * -8px), calc(var(--py, 0) * -6px), 0);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-collision__grade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(100deg, rgba(7, 16, 28, 0.72) 0%, rgba(7, 16, 28, 0.15) 38%, rgba(8, 16, 10, 0.2) 62%, rgba(6, 12, 8, 0.78) 100%),
      linear-gradient(180deg, rgba(6, 9, 15, 0.55) 0%, transparent 28%, transparent 55%, rgba(6, 9, 15, 0.92) 100%);
  }

  /* living atmosphere layers */
  .hero-collision__aura {
    position: absolute;
    z-index: 2;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .hero-collision__aura--clear {
    width: min(70vw, 780px);
    height: min(70vw, 780px);
    left: -18vw;
    top: -22vh;
    background: radial-gradient(circle, rgba(58, 130, 190, 0.55), transparent 65%);
    animation: aura-drift-a 16s ease-in-out infinite;
  }
  .hero-collision__aura--natural {
    width: min(62vw, 700px);
    height: min(62vw, 700px);
    right: -16vw;
    bottom: -24vh;
    background: radial-gradient(circle, rgba(88, 148, 84, 0.5), transparent 65%);
    animation: aura-drift-b 19s ease-in-out infinite;
  }
  .hero-collision__aura--core {
    width: min(40vw, 420px);
    height: min(40vw, 420px);
    left: var(--seam);
    top: 42%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(200, 230, 255, 0.28), rgba(180, 220, 170, 0.12) 45%, transparent 70%);
    animation: aura-core 10s ease-in-out infinite;
  }
  @keyframes aura-drift-a {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(4%, 5%, 0); }
  }
  @keyframes aura-drift-b {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(-5%, -4%, 0); }
  }
  @keyframes aura-core {
    0%, 100% { opacity: 0.7; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.12); }
  }

  .hero-collision__stars {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.5;
    background-image:
      radial-gradient(1px 1px at 12% 22%, rgba(255, 255, 255, 0.9), transparent),
      radial-gradient(1px 1px at 28% 12%, rgba(200, 230, 255, 0.8), transparent),
      radial-gradient(1.5px 1.5px at 41% 30%, rgba(255, 255, 255, 0.7), transparent),
      radial-gradient(1px 1px at 55% 8%, rgba(255, 255, 255, 0.75), transparent),
      radial-gradient(1px 1px at 8% 44%, rgba(200, 230, 255, 0.6), transparent),
      radial-gradient(1.5px 1.5px at 66% 18%, rgba(255, 255, 255, 0.65), transparent),
      radial-gradient(1px 1px at 34% 52%, rgba(255, 255, 255, 0.5), transparent);
    mask-image: linear-gradient(90deg, #000 0%, #000 55%, transparent 80%);
    animation: stars-twinkle 7s ease-in-out infinite;
  }
  @keyframes stars-twinkle {
    0%, 100% { opacity: 0.42; }
    50% { opacity: 0.62; }
  }

  .hero-collision__grain {
    position: absolute;
    inset: -30%;
    z-index: 3;
    pointer-events: none;
    opacity: 0.05;
    background-image: radial-gradient(#fff 0.5px, transparent 0.6px);
    background-size: 3px 3px;
    animation: grain-shift 1.4s steps(2) infinite;
  }
  @keyframes grain-shift {
    0% { transform: translate(0, 0); }
    50% { transform: translate(1.4%, -0.8%); }
    100% { transform: translate(-0.8%, 1.2%); }
  }

  /* ── identity typography integrated into the environment ── */
  .hero-collision__content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1560px;
    padding: clamp(48px, 9vh, 110px) clamp(18px, 4vw, 64px) clamp(80px, 12vh, 140px);
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .hero-collision__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 clamp(10px, 2vh, 18px);
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(0.55rem, 1vw, 0.68rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(232, 240, 250, 0.72);
  }
  .hero-collision__eyebrow::before,
  .hero-collision__eyebrow::after {
    content: "";
    width: clamp(18px, 4vw, 44px);
    height: 1px;
    background: linear-gradient(90deg, transparent, currentColor);
    opacity: 0.5;
  }
  .hero-collision__eyebrow::after {
    background: linear-gradient(90deg, currentColor, transparent);
  }

  .hero-collision__title {
    margin: 0;
    font-family: "IM FELL English", "EB Garamond", serif;
    font-weight: 400;
    font-size: clamp(3.4rem, 13vw, 10.5rem);
    line-height: 0.86;
    letter-spacing: -0.035em;
    color: #f4f9ff;
    text-shadow:
      0 4px 40px rgba(0, 0, 0, 0.55),
      0 0 90px rgba(120, 180, 255, 0.25);
  }
  .hero-collision__title em {
    font-style: italic;
    color: #eef7e3;
    text-shadow:
      0 4px 40px rgba(0, 0, 0, 0.55),
      0 0 90px rgba(160, 210, 130, 0.28);
  }

  .hero-collision__tagline {
    margin: clamp(14px, 2.5vh, 26px) 0 0;
    max-width: 40ch;
    font-family: "EB Garamond", "Cormorant Garamond", serif;
    font-style: italic;
    font-size: clamp(1.05rem, 2.4vw, 1.7rem);
    line-height: 1.3;
    color: rgba(240, 246, 252, 0.88);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }

  .hero-collision__worlds {
    margin: clamp(10px, 1.8vh, 16px) 0 0;
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(0.5rem, 0.9vw, 0.62rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(220, 235, 248, 0.55);
  }

  /* ── symbolic center: & emblem ── */
  .hero-collision__seam {
    position: absolute;
    z-index: 6;
    left: 50%;
    bottom: clamp(18px, 4vh, 44px);
    transform: translateX(-50%);
    display: grid;
    place-items: center;
  }
  .hero-emblem {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(64px, 10vw, 108px);
    height: clamp(64px, 10vw, 108px);
    border-radius: 50%;
    color: #f4f9ff;
    text-decoration: none;
    background: radial-gradient(circle, rgba(200, 230, 255, 0.16), rgba(180, 220, 160, 0.08) 55%, transparent 72%);
    border: 1px solid rgba(230, 244, 255, 0.35);
    box-shadow:
      0 0 40px rgba(159, 217, 255, 0.25),
      0 0 40px rgba(189, 217, 164, 0.18),
      inset 0 0 30px rgba(255, 255, 255, 0.06);
    transition: box-shadow 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease;
  }
  .hero-emblem:hover,
  .hero-emblem:focus-visible {
    transform: scale(1.06);
    border-color: rgba(255, 255, 255, 0.75);
    box-shadow:
      0 0 70px rgba(159, 217, 255, 0.45),
      0 0 70px rgba(189, 217, 164, 0.35),
      inset 0 0 40px rgba(255, 255, 255, 0.1);
  }
  .hero-emblem:focus-visible {
    outline: 2px solid #eaf6ff;
    outline-offset: 4px;
  }
  .hero-emblem__glyph {
    width: 72%;
    height: 72%;
    animation: emblem-turn 80s linear infinite;
  }
  .hero-emblem__glyph svg { width: 100%; height: 100%; display: block; }
  @keyframes emblem-turn {
    to { transform: rotate(360deg); }
  }
  .hero-emblem__amp {
    position: absolute;
    font-family: "IM FELL English", serif;
    font-style: italic;
    font-size: clamp(0.85rem, 1.6vw, 1.2rem);
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.5);
    line-height: 1;
  }
  .hero-emblem__ring {
    position: absolute;
    inset: -7px;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.22);
    animation: emblem-turn 60s linear infinite reverse;
    pointer-events: none;
  }
  .hero-emblem__cue {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.5rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(240, 248, 255, 0.6);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .hero-emblem:hover .hero-emblem__cue,
  .hero-emblem:focus-visible .hero-emblem__cue { opacity: 1; }

  /* quick world links flanking the emblem on wider screens */
  .hero-collision__quick {
    position: absolute;
    z-index: 6;
    left: 0;
    right: 0;
    bottom: clamp(20px, 4.5vh, 48px);
    display: none;
    justify-content: space-between;
    padding: 0 clamp(16px, 3vw, 44px);
    pointer-events: none;
  }
  .hero-quick-link {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.55rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid rgba(191, 228, 255, 0.35);
    color: rgba(234, 246, 255, 0.9);
    background: rgba(7, 16, 28, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.25s ease;
  }
  .hero-quick-link--nat {
    border-color: rgba(199, 227, 177, 0.4);
    color: rgba(240, 248, 231, 0.92);
    background: rgba(10, 20, 12, 0.45);
  }
  .hero-quick-link:hover,
  .hero-quick-link:focus-visible {
    border-color: rgba(255, 255, 255, 0.8);
    transform: translateY(-2px);
  }
  .hero-quick-link:focus-visible {
    outline: 2px solid #eaf6ff;
    outline-offset: 3px;
  }
  @media (min-width: 860px) {
    .hero-collision__quick { display: flex; }
  }

  /* ── mobile ── */
  @media (max-width: 640px) {
    .hero-collision {
      min-height: min(78svh, 680px);
    }
    .hero-collision__content {
      padding: clamp(40px, 10vh, 80px) 16px clamp(96px, 14vh, 130px);
    }
    .hero-collision__title {
      font-size: clamp(3rem, 16vw, 4.4rem);
      line-height: 0.9;
    }
    .hero-collision__title em {
      display: block;
    }
    .hero-collision__bed img {
      object-position: center 42%;
      opacity: 0.42;
      transform: scale(1.3) translate3d(calc(var(--px, 0) * -6px), calc(var(--py, 0) * -4px), 0);
    }
    .hero-collision__grade {
      background:
        linear-gradient(100deg, rgba(7, 16, 28, 0.5) 0%, rgba(7, 16, 28, 0.18) 40%, rgba(8, 16, 10, 0.22) 60%, rgba(6, 12, 8, 0.55) 100%),
        linear-gradient(180deg, rgba(6, 9, 15, 0.6) 0%, transparent 30%, transparent 50%, rgba(6, 9, 15, 0.94) 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-collision__aura,
    .hero-collision__stars,
    .hero-collision__grain,
    .hero-emblem__glyph,
    .hero-emblem__ring {
      animation: none !important;
    }
    .hero-collision__bed img {
      transition: none;
      transform: scale(1.04);
    }
  }
</style>

<header class="hero-collision" data-hero>
  <div class="hero-collision__bed" aria-hidden="true" data-depth="6">
    <img src="/clearnatural.png" alt="" decoding="async" fetchpriority="high" />
  </div>
  <div class="hero-collision__grade" aria-hidden="true"></div>
  <div class="hero-collision__aura hero-collision__aura--clear" aria-hidden="true"></div>
  <div class="hero-collision__aura hero-collision__aura--natural" aria-hidden="true"></div>
  <div class="hero-collision__aura hero-collision__aura--core" aria-hidden="true"></div>
  <div class="hero-collision__stars" aria-hidden="true"></div>
  <div class="hero-collision__grain" aria-hidden="true"></div>

  <div class="hero-collision__content">
    <p class="hero-collision__eyebrow">{identity.mark} two climates · one life</p>
    <h1 class="hero-collision__title" id="home-title">
      Icy <em>Clearer</em>
    </h1>
    <p class="hero-collision__tagline">{identity.tagline}</p>
    <p class="hero-collision__worlds">{identity.subtitle}</p>
  </div>

  <div class="hero-collision__quick" aria-label="Climate doors">
    {clearDoor && (
      <a class="hero-quick-link" href={clearDoor.href}>
        <span aria-hidden="true">{clearDoor.glyph}</span> {clearDoor.title}
      </a>
    )}
    {naturalDoor && (
      <a class="hero-quick-link hero-quick-link--nat" href={naturalDoor.href}>
        {naturalDoor.title} <span aria-hidden="true">{naturalDoor.glyph}</span>
      </a>
    )}
  </div>

  <div class="hero-collision__seam">
    <a class="hero-emblem" href="/worlds.html" aria-label="Enter Two Worlds — the boundary between Clear and Natural">
      <span class="hero-emblem__ring" aria-hidden="true"></span>
      <span class="hero-emblem__glyph" aria-hidden="true">
        <svg viewBox="0 0 80 80" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <g stroke="#bfe4ff" stroke-width="1.3" opacity="0.9">
            <line x1="40" y1="8" x2="40" y2="26" />
            <line x1="20" y1="16" x2="40" y2="25" />
            <line x1="60" y1="16" x2="40" y2="25" />
            <polyline points="34,10 40,16 46,10" />
          </g>
          <g stroke="#c7e3b1" stroke-width="1.3" opacity="0.9">
            <path d="M18 70 C 24 54, 40 48, 62 50 C 60 64, 46 72, 20 72 Z" />
            <path d="M18 70 C 30 62, 44 56, 58 50" />
          </g>
        </svg>
      </span>
      <span class="hero-emblem__amp" aria-hidden="true">&amp;</span>
      <span class="hero-emblem__cue" aria-hidden="true">Two Worlds</span>
    </a>
  </div>
</header>
