---
// SignalRow — small footer portals. Only real configured links.

import { homeContent } from '../../data/home';

const { signals } = homeContent;
---

<style is:global>
  .signal-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .signal {
    --accent: #e8e4d8;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    border: 1px solid rgba(232, 228, 216, 0.16);
    background: rgba(10, 15, 24, 0.55);
    color: rgba(238, 233, 220, 0.78);
    text-decoration: none;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.3s ease, color 0.3s ease, transform 0.25s ease, background 0.3s ease;
  }
  .signal:hover,
  .signal:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--accent);
    background: rgba(14, 20, 32, 0.75);
    transform: translateY(-2px);
  }
  .signal:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .signal__glyph {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
    font-size: 0.65rem;
    flex-shrink: 0;
  }

  .signal__label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .signal__label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .signal {
      padding: 10px;
      min-width: 44px;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal { transition: none; }
    .signal:hover { transform: none; }
  }
</style>

<nav class="signal-row" aria-label="External signals">
  {signals.map((s) => (
    <a
      class="signal"
      style={`--accent: ${s.accent ?? '#e8e4d8'};`}
      href={s.href}
      target={s.external ? '_blank' : undefined}
      rel={s.external ? 'noopener' : undefined}
      aria-label={s.label}
    >
      <span class="signal__glyph" aria-hidden="true">{s.glyph ?? '✦'}</span>
      <span class="signal__label">{s.label}</span>
    </a>
  ))}
</nav>
