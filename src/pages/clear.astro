---
import '../styles/philosophy-family.css';
import '../styles/clear-essay.css';
import PhilosophyHeader from '../components/philosophy/PhilosophyHeader.astro';
import PhilosophyFooter from '../components/philosophy/PhilosophyFooter.astro';
import ModelGlyph from '../components/philosophy/ModelGlyph.astro';
import {
  clearElements,
  clearCadence,
  generativeStages,
  writtenModels,
} from '../data/philosophy-family';

// Build unique undirected relational chord pairs for the non-hierarchical ecology diagram
const chordPairs: { key: string; a: (typeof clearElements)[0]; b: (typeof clearElements)[0] }[] = [];
const seen = new Set<string>();
for (const el of clearElements) {
  for (const targetId of el.supports) {
    const target = clearElements.find((c) => c.id === targetId);
    if (!target) continue;
    const key = [el.id, target.id].sort().join(':');
    if (seen.has(key)) continue;
    seen.add(key);
    chordPairs.push({ key, a: el, b: target });
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>ICY CLEAR — Life as Continuous Development</title>
    <meta
      name="description"
      content="A personal philosophy of resources, security, freedom, creation, living, and renewal. Development is part of my life, not preparation for it."
    />
    <meta name="theme-color" content="#070c10" />
    <meta property="og:title" content="ICY CLEAR — Life as Continuous Development" />
    <meta
      property="og:description"
      content="My perspective, still developing. Learning, making, experiencing, and being alive are the process."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/clear/fonts/bodoni.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/clear/fonts/bodoni-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/clear/fonts/barlow.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/clear/fonts/plex-mono.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body class="ph-doc">
    <a class="ph-skip" href="#main">Skip to philosophy</a>

    <PhilosophyHeader active="clear" />

    <main id="main">
      <!-- ── HERO ────────────────────────────────────────────────────────── -->
      <section class="cl-hero" aria-labelledby="hero-title">
        <svg class="cl-hero__orbit" viewBox="0 0 600 600" fill="none" aria-hidden="true">
          <circle cx="300" cy="300" r="268" stroke="rgba(157,207,228,0.14)" />
          <circle cx="300" cy="300" r="196" stroke="rgba(228,186,117,0.13)" stroke-dasharray="4 6" />
          <circle cx="300" cy="300" r="118" stroke="rgba(168,213,194,0.16)" />
          <line x1="300" y1="20" x2="300" y2="580" stroke="rgba(168,198,204,0.06)" />
          <line x1="20" y1="300" x2="580" y2="300" stroke="rgba(168,198,204,0.06)" />
        </svg>

        <div class="ph-shell cl-hero__inner">
          <div>
            <p class="ph-mono cl-hero__kicker">
              HOW I SEE IT <span>·</span> AN OPEN PERSONAL FRAMEWORK
            </p>
            <h1 class="cl-hero__title" id="hero-title">
              Life as<br /><em>continuous</em><br />development.
            </h1>
            <p class="cl-hero__lede">
              I don't see development as a phase I must complete before I can start living.
              Learning, experimenting, creating, exploring, and enjoying the process{' '}
              <strong>are already ways of living.</strong>
            </p>
            <div class="cl-hero__actions">
              <a class="cl-link-line" href="#framework">
                Explore the six interacting parts <span aria-hidden="true">↓</span>
              </a>
              <a class="cl-link-line cl-link-line--quiet" href="/generative-reality.html">
                Companion: Generative Reality <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <p class="cl-hero__marginalia">
            NOT A FINISH LINE<br />
            NOT A LADDER OF LEVELS<br />
            NOT A SET OF INSTRUCTIONS<br />
            A WAY I CURRENTLY SEE
          </p>
        </div>
      </section>

      <!-- ── THE CENTER (00) ─────────────────────────────────────────────── -->
      <section class="cl-center" aria-labelledby="thesis-title">
        <div class="ph-shell cl-split">
          <p class="ph-mono cl-index">THE CENTER / 00</p>
          <div>
            <h2 class="cl-h2" id="thesis-title">
              The means are not<br /><em>the destination.</em>
            </h2>
            <p class="cl-center__body">
              I want money to take courses, develop abilities, build things, explore places, and do what I enjoy.
              I value resources for the possibilities they protect and open — not simply for the size of what I possess.
            </p>
            <blockquote class="cl-center__quote">
              “Development is not preparation for my life. Development is part of my life.”
            </blockquote>

            <div class="cl-contrast-bar">
              <div class="cl-contrast-cell">
                <span>Deferred Model · Not How I See It</span>
                <p>Accumulate first → reach an arbitrary finish line → postpone curiosity → someday begin living.</p>
              </div>
              <div class="cl-contrast-cell cl-contrast-cell--living">
                <span>Continuous Development · Interacting Now</span>
                <p>Resources, security, freedom, creation, living, and renewal continually feed and rebalance one another in the present.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── SIX INTERACTING PARTS (#framework) ──────────────────────────── -->
      <section class="cl-framework" id="framework" aria-labelledby="framework-title">
        <div class="ph-shell">
          <div class="cl-split">
            <p class="ph-mono cl-index">A LIVING ECOLOGY / 01–06</p>
            <div>
              <h2 class="cl-h2" id="framework-title">
                What makes<br /><em>life possible.</em>
              </h2>
              <p class="cl-center__body">
                These six ideas support and balance one another. I don't treat them as mandatory levels people must finish in order — or as stages I leave behind once completed.
              </p>
            </div>
          </div>

          <!-- Non-hierarchical Relational Constellation -->
          <div class="cl-ecology" data-cl-ecology>
            <svg
              class="cl-ecology__svg"
              viewBox="0 0 420 356"
              fill="none"
              role="img"
              aria-label="Non-hierarchical diagram showing how Resources, Security, Freedom, Creation, Living, and Renewal interact"
            >
              <circle cx="210" cy="170" r="118" stroke="rgba(168,198,204,0.12)" stroke-dasharray="3 5" />
              <text x="210" y="167" text-anchor="middle" fill="#677a7d" font-family="ClearMono, monospace" font-size="8.5" letter-spacing="1.6">INTERACTING</text>
              <text x="210" y="181" text-anchor="middle" fill="#677a7d" font-family="ClearMono, monospace" font-size="8.5" letter-spacing="1.6">NOT A LADDER</text>

              {chordPairs.map((pair) => (
                <line
                  class="cl-eco-chord"
                  data-eco-chord={pair.key}
                  x1={pair.a.x}
                  y1={pair.a.y}
                  x2={pair.b.x}
                  y2={pair.b.y}
                />
              ))}

              {clearElements.map((el, idx) => (
                <g
                  class:list={['cl-eco-node', { 'is-active': idx === 0 }]}
                  data-eco-node={el.id}
                  tabindex="0"
                  role="button"
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                  aria-label={`${el.number} ${el.title} — ${el.subtitle}`}
                >
                  <circle class="node-ring" cx={el.x} cy={el.y} r="28" />
                  <circle cx={el.x} cy={el.y} r="3.2" fill={el.accent} />
                  <text x={el.x} y={el.y > 180 ? el.y + 44 : el.y - 36} text-anchor="middle">{el.number} · {el.title}</text>
                </g>
              ))}
            </svg>

            <div class="cl-ecology__readout" aria-live="polite">
              <div class="cl-ecology__pills" role="group" aria-label="Inspect element interactions">
                {clearElements.map((el, idx) => (
                  <button
                    type="button"
                    class:list={['cl-ecology__pill', { 'is-active': idx === 0 }]}
                    data-eco-pill={el.id}
                    aria-pressed={idx === 0 ? 'true' : 'false'}
                  >
                    {el.number} {el.title}
                  </button>
                ))}
              </div>
              <p class="cl-ecology__sub" data-eco-sub>01 / The means</p>
              <h3 class="cl-ecology__title" data-eco-title>Resources</h3>
              <p class="cl-ecology__rel" data-eco-rel>{clearElements[0].relationNote}</p>
              <a class="cl-ecology__jump" data-eco-jump href="#element-resources">Read Resources ↓</a>
            </div>
          </div>
        </div>

        <!-- Six Distinct Editorial Plates -->
        <div class="cl-plates">
          <!-- 01 · RESOURCES -->
          <article class="cl-plate" id="element-resources" style={`--plate-accent:${clearElements[0].accent}`}>
            <div class="ph-shell cl-plate__grid">
              <div class="cl-plate__copy">
                <p class="cl-plate__kicker">01 / {clearElements[0].subtitle}</p>
                <h3 class="cl-plate__title">Resources</h3>
                <p class="cl-plate__desc">{clearElements[0].description}</p>
                <p class="cl-plate__note">{clearElements[0].note}</p>
                <div class="cl-plate__links">
                  <span>Interacts with:</span>
                  <a href="#element-security">Security</a>
                  <a href="#element-freedom">Freedom</a>
                  <a href="#element-creation">Creation</a>
                </div>
              </div>

              <div class="cl-plate__study">
                <div class="cl-study cl-study--resources" data-study-resources data-mode="directed">
                  <div class="cl-study__bar">
                    <span data-res-state>Capacity flowing into possibilities</span>
                    <button type="button" class="cl-study__toggle" data-res-toggle>Compare: accumulated</button>
                  </div>
                  <svg viewBox="0 0 420 210" fill="none" role="img" aria-label="Diagram comparing closed resource accumulation against capacity directed outward into possibilities">
                    <!-- Closed vault pile (subtle when directed) -->
                    <g class="res-flow res-pile">
                      <rect x="30" y="54" width="96" height="106" stroke="#e2b872" stroke-opacity="0.7" fill="rgba(226,184,114,0.08)" />
                      <line x1="42" y1="84" x2="114" y2="84" stroke="#e2b872" stroke-opacity="0.45" />
                      <line x1="42" y1="106" x2="114" y2="106" stroke="#e2b872" stroke-opacity="0.45" />
                      <line x1="42" y1="128" x2="114" y2="128" stroke="#e2b872" stroke-opacity="0.45" />
                      <text x="78" y="180" text-anchor="middle" fill="#98a9aa" font-family="ClearMono, monospace" font-size="9">STORE</text>
                    </g>
                    <!-- Outward directed channels -->
                    <g class="res-flow res-directed">
                      <path d="M126 78 C200 78, 232 42, 378 36" stroke="#e2b872" stroke-width="1.6" />
                      <path d="M126 96 C210 96, 248 80, 382 80" stroke="#9dcfe4" stroke-width="1.5" />
                      <path d="M126 114 C210 114, 248 128, 382 128" stroke="#a8d5c2" stroke-width="1.5" />
                      <path d="M126 132 C200 132, 238 168, 378 172" stroke="#e0a96d" stroke-width="1.5" />
                      <text x="386" y="40" text-anchor="end" fill="#e2b872" font-family="ClearMono, monospace" font-size="8.5">COURSES</text>
                      <text x="386" y="84" text-anchor="end" fill="#9dcfe4" font-family="ClearMono, monospace" font-size="8.5">TOOLS</text>
                      <text x="386" y="132" text-anchor="end" fill="#a8d5c2" font-family="ClearMono, monospace" font-size="8.5">TIME &amp; HEALTH</text>
                      <text x="386" y="176" text-anchor="end" fill="#e0a96d" font-family="ClearMono, monospace" font-size="8.5">EXPERIMENTS</text>
                    </g>
                  </svg>
                </div>
              </div>
            </div>
          </article>

          <!-- 02 · SECURITY -->
          <article class="cl-plate cl-plate--flip" id="element-security" style={`--plate-accent:${clearElements[1].accent}`}>
            <div class="ph-shell cl-plate__grid">
              <div class="cl-plate__copy">
                <p class="cl-plate__kicker">02 / {clearElements[1].subtitle}</p>
                <h3 class="cl-plate__title">Security</h3>
                <p class="cl-plate__desc">{clearElements[1].description}</p>
                <p class="cl-plate__note">{clearElements[1].note}</p>
                <div class="cl-plate__links">
                  <span>Interacts with:</span>
                  <a href="#element-resources">Resources</a>
                  <a href="#element-freedom">Freedom</a>
                  <a href="#element-renewal">Renewal</a>
                </div>
              </div>

              <div class="cl-plate__study">
                <div class="cl-study cl-study--security" data-study-security data-shock="false">
                  <div class="cl-study__bar">
                    <span data-sec-state>Continuity beneath open sky</span>
                    <button type="button" class="cl-study__toggle" data-sec-pulse>Test setback</button>
                  </div>
                  <svg viewBox="0 0 420 210" fill="none" role="img" aria-label="Diagram of a steady keel absorbing waves while keeping the open sky accessible above">
                    <text x="20" y="34" fill="#677a7d" font-family="ClearMono, monospace" font-size="8.5" letter-spacing="1.2">OPEN FIELD ABOVE · UNBLOCKED</text>
                    <!-- Disturbance waves on surface -->
                    <path class="sec-wave sec-wave-top" d="M20 102 Q70 84, 120 102 T220 102 T320 102 T400 102" stroke="#9dcfe4" stroke-width="1.5" />
                    <path class="sec-wave" d="M20 116 Q80 104, 140 116 T260 116 T400 116" stroke="rgba(157,207,228,0.35)" stroke-dasharray="4 4" />
                    <!-- Steady keel foundation -->
                    <path d="M90 132 L330 132 L286 172 L134 172 Z" fill="rgba(157,207,228,0.09)" stroke="#9dcfe4" stroke-width="1.4" />
                    <line x1="210" y1="68" x2="210" y2="172" stroke="rgba(228,186,117,0.5)" stroke-dasharray="3 3" />
                    <text x="210" y="156" text-anchor="middle" fill="#9dcfe4" font-family="ClearMono, monospace" font-size="9">STABILITY KEEL</text>
                  </svg>
                </div>
              </div>
            </div>
          </article>

          <!-- 03 · FREEDOM -->
          <article class="cl-plate" id="element-freedom" style={`--plate-accent:${clearElements[2].accent}`}>
            <div class="ph-shell cl-plate__grid">
              <div class="cl-plate__copy">
                <p class="cl-plate__kicker">03 / {clearElements[2].subtitle}</p>
                <h3 class="cl-plate__title">Freedom</h3>
                <p class="cl-plate__desc">{clearElements[2].description}</p>
                <p class="cl-plate__note">{clearElements[2].note}</p>
                <div class="cl-plate__links">
                  <span>Interacts with:</span>
                  <a href="#element-creation">Creation</a>
                  <a href="#element-living">Living</a>
                  <a href="#element-renewal">Renewal</a>
                </div>
              </div>

              <div class="cl-plate__study">
                <div class="cl-study cl-study--freedom" data-study-freedom data-door="1">
                  <div class="cl-study__bar">
                    <span data-free-state>Door 02 · Unhurried creation</span>
                    <button type="button" class="cl-study__toggle" data-free-shift>Shift attention</button>
                  </div>
                  <svg viewBox="0 0 420 210" fill="none" role="img" aria-label="Three architectural doorways showing meaningful choice as directed attention">
                    <!-- Three architectural portals -->
                    <rect x="44" y="34" width="76" height="142" stroke="rgba(200,223,236,0.45)" />
                    <rect x="172" y="34" width="76" height="142" stroke="rgba(200,223,236,0.65)" />
                    <rect x="300" y="34" width="76" height="142" stroke="rgba(200,223,236,0.45)" />
                    <!-- Illuminated active doorway rays -->
                    <polygon class="free-ray free-ray--0" points="44,176 120,176 146,204 18,204" fill="rgba(157,207,228,0.28)" />
                    <rect class="free-ray free-ray--0" x="48" y="38" width="68" height="134" fill="rgba(157,207,228,0.12)" stroke="#9dcfe4" />
                    <polygon class="free-ray free-ray--1" points="172,176 248,176 274,204 146,204" fill="rgba(228,186,117,0.28)" />
                    <rect class="free-ray free-ray--1" x="176" y="38" width="68" height="134" fill="rgba(228,186,117,0.12)" stroke="#e4ba75" />
                    <polygon class="free-ray free-ray--2" points="300,176 376,176 402,204 274,204" fill="rgba(168,213,194,0.28)" />
                    <rect class="free-ray free-ray--2" x="304" y="38" width="68" height="134" fill="rgba(168,213,194,0.12)" stroke="#a8d5c2" />
                    <text x="82" y="112" text-anchor="middle" fill="#cfd8d4" font-family="ClearMono, monospace" font-size="9">01 STUDY</text>
                    <text x="210" y="112" text-anchor="middle" fill="#cfd8d4" font-family="ClearMono, monospace" font-size="9">02 MAKE</text>
                    <text x="338" y="112" text-anchor="middle" fill="#cfd8d4" font-family="ClearMono, monospace" font-size="9">03 LIVE</text>
                  </svg>
                </div>
              </div>
            </div>
          </article>

          <!-- 04 · CREATION -->
          <article class="cl-plate cl-plate--flip" id="element-creation" style={`--plate-accent:${clearElements[3].accent}`}>
            <div class="ph-shell cl-plate__grid">
              <div class="cl-plate__copy">
                <p class="cl-plate__kicker">04 / {clearElements[3].subtitle}</p>
                <h3 class="cl-plate__title">Creation</h3>
                <p class="cl-plate__desc">{clearElements[3].description}</p>
                <p class="cl-plate__note">{clearElements[3].note}</p>
                <div class="cl-plate__links">
                  <span>In practice:</span>
                  <a href="/creations.html">Creations Palette ↗</a>
                  <a href="/music.html">Music ↗</a>
                  <a href="/generative-reality.html#orchestration">Orchestration ↗</a>
                </div>
              </div>

              <div class="cl-plate__study">
                <div class="cl-study">
                  <div class="cl-study__bar">
                    <span>Open drafting field · no required finish line</span>
                    <span>CURIOSITY → FORM</span>
                  </div>
                  <svg viewBox="0 0 420 210" fill="none" role="img" aria-label="Asymmetric experimental drafting geometry representing open creative prototypes">
                    <circle cx="132" cy="108" r="64" stroke="rgba(224,169,109,0.55)" />
                    <circle cx="132" cy="108" r="36" stroke="rgba(224,169,109,0.28)" stroke-dasharray="3 4" />
                    <path d="M40 162 Q132 22, 260 110 T390 48" stroke="#e4ba75" stroke-width="1.6" />
                    <rect x="234" y="66" width="126" height="82" stroke="rgba(157,207,228,0.45)" />
                    <line x1="234" y1="66" x2="360" y2="148" stroke="rgba(157,207,228,0.25)" />
                    <circle cx="260" cy="110" r="4.5" fill="#e4ba75" />
                    <circle cx="352" cy="64" r="3.5" fill="#a8d5c2" />
                    <text x="242" y="166" fill="#98a9aa" font-family="ClearMono, monospace" font-size="8.5">PROTOTYPE · ART · SOFTWARE · SKILL</text>
                  </svg>
                </div>
              </div>
            </div>
          </article>

          <!-- 05 · LIVING (Inhabited with Chad's real lakeside photograph!) -->
          <article class="cl-plate cl-plate--living" id="element-living" style={`--plate-accent:${clearElements[4].accent}`}>
            <div class="ph-shell cl-plate__grid">
              <div class="cl-plate__copy">
                <p class="cl-plate__kicker">05 / {clearElements[4].subtitle}</p>
                <h3 class="cl-plate__title">Living</h3>
                <p class="cl-plate__desc">{clearElements[4].description}</p>
                <p class="cl-plate__note">{clearElements[4].note}</p>
                <div class="cl-plate__links">
                  <span>Inside the archive:</span>
                  <a href="/moments.html">Moments Observatory ↗</a>
                  <a href="/basketball.html">Basketball ↗</a>
                  <a href="/games.html">Gaming ↗</a>
                </div>
              </div>

              <div class="cl-plate__study">
                <figure class="cl-living-photo" style="margin:0">
                  <img
                    src="/media/home/life/19781-lake-poster.jpg"
                    alt="Real lake shoreline photographed by Chad — already inside life now"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="cl-living-photo__caption">
                    <span>Not preparation — already here</span>
                    <span>LAKE ARCHIVE</span>
                  </figcaption>
                </figure>
              </div>
            </div>
          </article>

          <!-- 06 · RENEWAL -->
          <article class="cl-plate cl-plate--flip cl-plate--renewal" id="element-renewal" style={`--plate-accent:${clearElements[5].accent}`}>
            <div class="ph-shell cl-plate__grid">
              <div class="cl-plate__copy">
                <p class="cl-plate__kicker">06 / {clearElements[5].subtitle}</p>
                <h3 class="cl-plate__title">Renewal</h3>
                <p class="cl-plate__desc">{clearElements[5].description}</p>
                <p class="cl-plate__note">{clearElements[5].note}</p>
                <div class="cl-plate__links">
                  <span>Related lens:</span>
                  <a href="/models/clear-again.html">M-05 Clear Again ↗</a>
                  <a href="/modes/parasympathetic-lead-mode.html">Parasympathetic Lead Mode ↗</a>
                </div>
              </div>

              <div class="cl-plate__study">
                <div class="cl-study">
                  <div class="cl-study__bar">
                    <span>Rest &amp; return · no output required</span>
                    <span>DAMPING TO BASELINE</span>
                  </div>
                  <svg viewBox="0 0 420 210" fill="none" role="img" aria-label="Damped curve gradually settling back to a calm centerline">
                    <line x1="24" y1="106" x2="396" y2="106" stroke="rgba(168,198,204,0.22)" stroke-dasharray="3 4" />
                    <path
                      d="M24 106 C50 32, 74 178, 108 106 C134 56, 158 154, 192 106 C216 74, 240 136, 272 106 C296 89, 318 122, 344 106 C362 98, 378 112, 396 106"
