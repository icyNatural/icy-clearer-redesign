        </div>
      </section>

      <!-- ── WHAT IS ENOUGH? (MINERAL PAPER CONTRAST) ────────────────────── -->
      <section class="cl-enough" id="enough" aria-labelledby="enough-title">
        <div class="ph-shell">
          <div class="cl-enough__grid">
            <div>
              <p class="ph-mono cl-index">THE BALANCE / 07</p>
              <h2 class="cl-h2" id="enough-title">
                What is<br /><em>enough?</em>
              </h2>

              <div class="cl-fulcrum" data-cl-fulcrum data-balance="living">
                <div class="cl-fulcrum__tabs" role="group" aria-label="Inspect states of enough">
