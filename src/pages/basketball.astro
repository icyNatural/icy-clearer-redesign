---
import { basketballWorld } from '../data/living-worlds';

const primary = basketballWorld.leadFootage;
const extraClips = basketballWorld.clips.slice(1);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Basketball — Icy Clearer</title>
  <meta name="description" content="Real court footage, movement study, and personal basketball archive by Icy Clearer." />
  <meta name="theme-color" content="#14100d" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to basketball</a>

  <header class="court-nav">
    <a class="court-nav__back" href="/#basketball">← HOME</a>
    <nav aria-label="Basketball navigation">
      <a href="#footage">Footage</a>
      <a href="#movement">Movement</a>
      {basketballWorld.hoopFocus && (
        <a href={basketballWorld.hoopFocus.href} target="_blank" rel="noopener noreferrer">Hoop Focus ↗</a>
      )}
      <a href="/natural.html#play">Natural Play ↗</a>
    </nav>
  </header>

  <main id="main" class="court-shell" tabindex="-1">
    <section class="court-hero" aria-labelledby="court-title">
      <div class="court-hero__copy">
        <p class="mono kicker">ICY CLEARER / BASKETBALL</p>
        <h1 id="court-title">Basketball<span>.</span></h1>
        <p class="hero-lead">
          Hesitation, footwork, timing, balance, reading open space. Real footage from the floor — built honestly from what exists rather than padded stats.
        </p>
        <div class="hero-stats mono">
          <span>{basketballWorld.clips.length} VERIFIED REEL</span>
          <span>FILM STUDY CONTROLS</span>
          <span>EXPANDS FROM NATURAL</span>
        </div>
      </div>

      <figure class="court-portrait">
        <img src={basketballWorld.portrait.src} alt={basketballWorld.portrait.alt} width="720" height="720" />
        <figcaption>Chad — personal archive</figcaption>
      </figure>
    </section>

    <section class="footage-room" id="footage" aria-labelledby="footage-title">
      <header class="section-head">
        <div>
          <p class="mono kicker">01 / COURT FILM</p>
          <h2 id="footage-title">{primary.title}</h2>
        </div>
        <p class="mono count">NATIVE RATIO · FRAME STUDY</p>
      </header>

      <div class="film-stage">
        <div class="film-player-wrap">
          <video
            id="primary-court-video"
            src={primary.videoSrc}
            poster={primary.poster}
            controls
            playsinline
            preload="metadata"
            aria-label={`Basketball clip: ${primary.title}`}
          ></video>
        </div>

        <aside class="film-controls" aria-label="Basketball film study controls">
          <p class="mono control-label">PLAYBACK SPEED</p>
          <div class="speed-group" role="group" aria-label="Playback speed">
            <button type="button" data-speed="0.5" aria-pressed="false">0.5× Footwork</button>
            <button type="button" data-speed="0.75" aria-pressed="false">0.75× Pace</button>
            <button type="button" data-speed="1" aria-pressed="true">1× Live</button>
          </div>

          <div class="utility-group">
            <button type="button" data-toggle-loop aria-pressed="false">Loop: Off</button>
            <button type="button" data-restart-video>Restart Clip ↺</button>
          </div>

          <p class="film-status mono" data-film-status role="status" aria-live="polite">
            Ready at 1× live speed. Slow down to 0.5× to study gather and separation.
          </p>

          <div class="film-note">
            <h3>What to notice</h3>
            <p>
              The hesitation freezes the defender's hips just long enough to open the pull-up window without rushing the gather. Pace creates space before speed does.
            </p>
          </div>
        </aside>
      </div>

      {extraClips.length > 0 && (
        <div class="extra-clips">
          <p class="mono kicker">ADDITIONAL COURT CLIPS</p>
          <div class="extra-grid">
            {extraClips.map((clip) => (
              <figure class="extra-clip">
                {clip.kind === 'video' ? (
                  <video src={clip.src} poster={clip.poster} controls playsinline preload="metadata" aria-label={clip.title}></video>
                ) : (
                  <img src={clip.src} alt={clip.title} loading="lazy" />
                )}
                <figcaption>{clip.title}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}
    </section>

    <section class="movement-room" id="movement" aria-labelledby="movement-title">
      <p class="mono kicker">02 / MOVEMENT &amp; CONNECTED INSTRUMENTS</p>
      <h2 id="movement-title">Beyond one clip.</h2>

      <div class="movement-columns">
        {basketballWorld.hoopFocus && (
          <article class="movement-entry">
            <p class="mono entry-tag">INSTRUMENT · {basketballWorld.hoopFocus.status.toUpperCase()}</p>
            <h3>{basketballWorld.hoopFocus.title}</h3>
            <p>{basketballWorld.hoopFocus.blurb}</p>
            <a class="inline-link" href={basketballWorld.hoopFocus.href} target="_blank" rel="noopener noreferrer">
              Visit Hoop Focus ↗
            </a>
          </article>
        )}

        {basketballWorld.motionLens && (
          <article class="movement-entry">
            <p class="mono entry-tag">LENS · OBSERVE MOVEMENT</p>
            <h3>{basketballWorld.motionLens.title}</h3>
            <p>{basketballWorld.motionLens.field}</p>
            <a class="inline-link" href={basketballWorld.motionLens.href} target="_blank" rel="noopener noreferrer">
              Open Motion Lens ↗
            </a>
          </article>
        )}

        <article class="movement-entry">
          <p class="mono entry-tag">LIVING ARCHIVE · EXPANDABLE</p>
          <h3>Room for future runs</h3>
          <p>
            No fabricated game logs or empty highlight boxes. As new court clips or photographs are added to Natural's basketball archive, they surface here automatically.
          </p>
          <a class="inline-link" href="/natural.html#play">
            View in Natural Play ↗
          </a>
        </article>
      </div>
    </section>
  </main>

  <footer class="court-footer mono">
    <a href="/#basketball">← RETURN TO LIVING HOME</a>
    <div>
      <a href="/games.html">GAMING ↗</a>
      <a href="/moments.html">MOMENTS ↗</a>
      <a href="/music.html">MUSIC ↗</a>
    </div>
  </footer>

  <script>
    const video = document.getElementById('primary-court-video') as HTMLVideoElement | null;
    const status = document.querySelector<HTMLElement>('[data-film-status]');
    const speedBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-speed]')];
    const loopBtn = document.querySelector<HTMLButtonElement>('[data-toggle-loop]');
    const restartBtn = document.querySelector<HTMLButtonElement>('[data-restart-video]');

    if (video) {
      speedBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const rate = Number(btn.dataset.speed || 1);
          video.playbackRate = rate;
          speedBtns.forEach((other) => other.setAttribute('aria-pressed', String(other === btn)));
          if (status) status.textContent = `Playback rate set to ${rate}×.`;
        });
      });

      loopBtn?.addEventListener('click', () => {
        video.loop = !video.loop;
        loopBtn.setAttribute('aria-pressed', String(video.loop));
        loopBtn.textContent = video.loop ? 'Loop: On' : 'Loop: Off';
        if (status) status.textContent = video.loop ? 'Clip looping enabled for repeat study.' : 'Clip looping turned off.';
      });

      restartBtn?.addEventListener('click', () => {
        video.currentTime = 0;
        video.play().catch(() => {});
        if (status) status.textContent = 'Restarted from 0:00.';
      });
    }
  </script>

  <style is:global>
    :root {
      --bg: #14100d;
      --bg-warm: #1d1712;
      --ink: #f3ead9;
      --muted: #b5a795;
      --cedar: #df954e;
      --line: rgba(235, 215, 185, .15);
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--bg); }
    body {
      margin: 0;
      background:
        radial-gradient(ellipse at 78% 12%, rgba(214, 134, 58, .15), transparent 52%),
        var(--bg);
      color: var(--ink);
      font-family: 'EB Garamond', Georgia, serif;
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    astro-dev-toolbar { display: none; }
    a { color: inherit; text-decoration: none; }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--cedar); outline-offset: 4px; }
    .skip-link { position: fixed; top: -120px; left: 16px; z-index: 100; padding: 12px 16px; background: var(--ink); color: var(--bg); font: 12px 'JetBrains Mono', monospace; }
    .skip-link:focus { top: 14px; }
    .mono { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
    .kicker { color: var(--cedar); margin: 0 0 10px; }

    .court-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px 24px;
      padding: 18px clamp(20px, 5vw, 72px);
      border-bottom: 1px solid var(--line);
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .court-nav nav { display: flex; flex-wrap: wrap; gap: 14px 26px; color: var(--muted); }
    .court-nav a { display: inline-flex; align-items: center; min-height: 44px; transition: color .2s ease; }
    .court-nav a:hover { color: var(--cedar); }

    .court-shell {
      max-width: 1240px;
      margin: 0 auto;
      padding: clamp(42px, 6vw, 84px) clamp(20px, 5vw, 72px) clamp(64px, 8vw, 112px);
    }

    .court-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(240px, 340px);
      align-items: center;
      gap: clamp(28px, 5vw, 68px);
      padding-bottom: clamp(48px, 6vw, 76px);
      border-bottom: 1px solid var(--line);
    }
    .court-hero h1 {
      margin: 0;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 400;
      font-size: clamp(60px, 9.5vw, 136px);
      line-height: .88;
      letter-spacing: -.05em;
    }
    .court-hero h1 span { color: var(--cedar); }
    .hero-lead {
      margin: 22px 0 0;
      max-width: 46ch;
      font-size: clamp(20px, 1.9vw, 25px);
      line-height: 1.45;
      color: var(--muted);
    }
    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
      margin-top: 26px;
      color: #cbbba8;
    }
    .court-portrait {
      margin: 0;
      padding: 10px 10px 30px;
      background: #efe6d5;
      color: #1e2520;
      box-shadow: 0 24px 56px rgba(0, 0, 0, .5);
      transform: rotate(2.6deg);
    }
    .court-portrait img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      object-position: center 22%;
    }
    .court-portrait figcaption {
      margin-top: 8px;
      font: italic 18px 'Cormorant Garamond', Georgia, serif;
    }

    .footage-room {
      padding-block: clamp(52px, 6vw, 84px);
      border-bottom: 1px solid var(--line);
    }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 14px 28px;
      margin-bottom: 32px;
    }
    .section-head h2, .movement-room h2 {
      margin: 0;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 400;
      font-size: clamp(38px, 5vw, 68px);
      line-height: .96;
      letter-spacing: -.035em;
    }
    .count { color: var(--muted); margin: 0; }

    .film-stage {
      display: grid;
      grid-template-columns: minmax(0, 390px) minmax(0, 1fr);
      gap: clamp(28px, 5vw, 68px);
      align-items: start;
    }
    .film-player-wrap {
      background: #090706;
      border: 1px solid var(--line);
      box-shadow: 0 28px 66px rgba(0, 0, 0, .55);
      overflow: hidden;
    }
    .film-player-wrap video {
      display: block;
      width: 100%;
      height: auto;
      max-height: 76svh;
      background: #000;
    }

    .film-controls {
      padding-top: 6px;
    }
    .control-label { color: var(--muted); margin: 0 0 12px; }
    .speed-group, .utility-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 18px;
    }
    .film-controls button {
      min-height: 44px;
      padding: 10px 16px;
      border: 1px solid rgba(235, 215, 185, .24);
      background: rgba(255, 245, 232, .03);
      color: var(--ink);
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: border-color .2s ease, background .2s ease, color .2s ease;
    }
    .film-controls button:hover { border-color: var(--cedar); }
    .film-controls button[aria-pressed="true"] {
      border-color: var(--cedar);
      background: rgba(223, 149, 78, .18);
      color: #fff6ea;
    }
    .film-status {
      margin: 6px 0 30px;
      color: var(--cedar);
      line-height: 1.6;
      text-transform: none;
      letter-spacing: .04em;
    }
    .film-note {
      padding-top: 22px;
      border-top: 1px solid var(--line);
    }
    .film-note h3 {
      margin: 0 0 10px;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 28px;
    }
    .film-note p {
      margin: 0;
      max-width: 50ch;
      font-size: 20px;
      line-height: 1.5;
      color: var(--muted);
    }

    .extra-clips { margin-top: 48px; }
    .extra-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-top: 16px; }
    .extra-clip { margin: 0; }
    .extra-clip video, .extra-clip img { width: 100%; display: block; border: 1px solid var(--line); }
    .extra-clip figcaption { margin-top: 8px; color: var(--muted); font-size: 18px; }

    .movement-room {
      padding-top: clamp(52px, 6vw, 84px);
    }
    .movement-columns {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(24px, 4vw, 48px);
      margin-top: 34px;
    }
    .movement-entry {
      padding-top: 18px;
      border-top: 1px solid var(--line);
    }
    .entry-tag { margin: 0 0 10px; color: var(--cedar); font-size: 10px; }
    .movement-entry h3 {
      margin: 0 0 10px;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 32px;
      line-height: 1.05;
    }
    .movement-entry p {
      margin: 0 0 18px;
      font-size: 19px;
      line-height: 1.5;
      color: var(--muted);
    }
    .inline-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      border-bottom: 1px solid rgba(223, 149, 78, .55);
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .inline-link:hover { color: var(--cedar); border-bottom-color: var(--cedar); }

    .court-footer {
      max-width: 1240px;
      margin: 0 auto;
      padding: 28px clamp(20px, 5vw, 72px) 48px;
      border-top: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px 24px;
      color: var(--muted);
    }
    .court-footer div { display: flex; flex-wrap: wrap; gap: 14px 24px; }
    .court-footer a { display: inline-flex; align-items: center; min-height: 44px; }
    .court-footer a:hover { color: var(--cedar); }

    @media (max-width: 820px) {
      .court-hero, .film-stage, .movement-columns { grid-template-columns: 1fr; }
      .court-portrait { max-width: 300px; transform: rotate(1.5deg); }
      .film-player-wrap { max-width: 420px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      * { transition: none !important; animation: none !important; }
    }
  </style>
</body>
</html>
