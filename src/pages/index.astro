  .nebula.b { width: 640px; height: 640px; bottom: -200px; right: -160px;
    background: radial-gradient(circle, #9bb88a, transparent 70%); animation: drift 90s ease-in-out infinite alternate-reverse; }
  @keyframes drift { from{transform:translate3d(0,0,0);} to{transform:translate3d(50px,-30px,0);} }
  .starfield { position: absolute; inset: 0; opacity: .55;
    background-image:
      radial-gradient(1px 1px at 20px 30px, #eaf4ff, transparent),
      radial-gradient(1px 1px at 80px 120px, #cfe7ff, transparent),
      radial-gradient(1.5px 1.5px at 160px 60px, #fff, transparent),
      radial-gradient(1px 1px at 220px 200px, #c0d8ff, transparent),
      radial-gradient(.8px .8px at 50px 220px, #cfe7ff, transparent),
