  .rl { left: 0; } .rr { right: 0; }
  @media (max-width: 760px){ .frame { font-size: .5rem; inset: 8px; } .mk.tr, .mk.br { display: none; } .rule { display: none; } }

  /* ── seal / bar ───────────────────────────────────────────── */
  .bar { position: sticky; top: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between;
    gap: 16px; padding: 14px max(22px, env(safe-area-inset-left));
