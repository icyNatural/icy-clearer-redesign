---
// NEW HOMEPAGE — Visual Identity Experience
// Completely separate from WORLD. Content-driven via home.ts manifest.

import HomeLayout from "../layouts/HomeLayout.astro";
import "../styles/foundation.css";
import "../styles/home.css";
import { homeContent } from "../data/home";
import IdentityBlock from "../components/home/IdentityBlock.astro";
import SectionBlock from "../components/home/SectionBlock.astro";
import PortfolioBlock from "../components/home/PortfolioBlock.astro";
import WorldDoorway from "../components/home/WorldDoorway.astro";
import EdgePortals from "../components/home/EdgePortals.astro";
---

<HomeLayout title="Icy Clearer — Personal visual identity" description="Systems, photography, experiments, media, and visual identity by Icy.">
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="environment" aria-hidden="true" data-atmosphere="void">
    <div class="environment__light environment__light--a"></div>
    <div class="environment__light environment__light--b"></div>
    <div class="environment__horizon"></div>
    <div class="environment__grid"></div>
    <div class="environment__grain"></div>
  </div>

  <main id="main" class="home-main" tabindex="-1">
    <div class="home-flow">

      {/* ═══ IDENTITY ═══ */}
      <header class="home-identity">
        <IdentityBlock identity={homeContent.identity} />
      </header>

      {/* ═══ GENERIC MEDIA SLOT GROUPS ═══ */}
      <section class="home-current" aria-label="Going crazy on">
        <div class="home-current__inner">
          <SectionBlock sectionId="current" />
        </div>
      </section>

      {/* ═══ HIGHLIGHTS — "Worth noticing" ═══ */}
      <section class="home-highlights" aria-label="Worth noticing">
        <div class="home-highlights__inner">
          <SectionBlock sectionId="highlights" />
        </div>
      </section>

      {/* ═══ OUTSIDE — "Outside with it" ═══ */}
      <section class="home-outside" aria-label="Outside with it">
        <div class="home-outside__inner">
          <SectionBlock sectionId="outside" />
        </div>
      </section>

      <div class="home-destinations">
        <section class="home-portfolio" aria-labelledby="portfolio-title">
          <PortfolioBlock block={homeContent.portfolio} />
        </section>
        <section class="home-world-doorway" aria-labelledby="world-doorway-title">
          <WorldDoorway block={homeContent.worldDoorway} />
        </section>
      </div>

      {/* ═══ FOOTER ═══ */}
      <footer class="home-foot" role="contentinfo">
        <div class="home-foot__inner">
          <EdgePortals items={homeContent.social.items} />
          <span class="home-foot__mark" aria-hidden="true">✦ Icy Clearer</span>
          <nav class="home-foot__nav" aria-label="Footer navigation">
            <a class="home-foot__link" href="/world.html">World</a>
            <a class="home-foot__link" href="/clear.html">Clear</a>
            <a class="home-foot__link" href="/natural.html">Natural</a>
            <a class="home-foot__link" href="/worlds.html">Two Worlds</a>
          </nav>
        </div>
      </footer>

    </div>
  </main>

  {/* ═══ POINTER PARALLAX ═══ */}
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var finePointer = window.matchMedia && window.matchMedia('(pointer: fine)').matches;

      if (reduceMotion || !finePointer) return;

      var currentSection = document.querySelector('.home-current');
      var highlightsSection = document.querySelector('.home-highlights');
      var outsideSection = document.querySelector('.home-outside');

      function onPointerMove(event) {
        var x = (event.clientX / window.innerWidth - 0.5) * 2;
        var y = (event.clientY / window.innerHeight - 0.5) * 2;

        root.style.setProperty('--pointer-x', String(x));
        root.style.setProperty('--pointer-y', String(y));

        var tx = x * 12;
        var ty = y * 8;

        if (currentSection) currentSection.style.transform = "translate3d(" + tx + "px, " + ty + "px, 0)";
        if (highlightsSection) highlightsSection.style.transform = "translate3d(" + (tx * 0.6) + "px, " + (ty * 0.6) + "px, 0)";
        if (outsideSection) outsideSection.style.transform = "translate3d(" + (tx * 0.4) + "px, " + (ty * 0.4) + "px, 0)";
      }

      function onPointerLeave() {
        root.style.setProperty('--pointer-x', '0');
        root.style.setProperty('--pointer-y', '0');
        if (currentSection) currentSection.style.transform = 'none';
        if (highlightsSection) highlightsSection.style.transform = 'none';
        if (outsideSection) outsideSection.style.transform = 'none';
      }

      document.addEventListener('pointermove', onPointerMove, { passive: true });
      document.addEventListener('pointerleave', onPointerLeave);
    })();
  </script>
</HomeLayout>