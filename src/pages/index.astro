  /* Compress space between hall and first plate */
  .hall + .plate { margin-top: 24px; }
  .hall + .plate .plate-head { margin-bottom: 24px; }




  /* ── ATLAS (celestial chart) ──────────────────────────────── */
  .atlas { position: relative; width: 100%; aspect-ratio: 16/10;
    background:
      radial-gradient(ellipse at 30% 30%, rgba(127,203,255,.07), transparent 60%),
      radial-gradient(ellipse at 75% 75%, rgba(155,184,138,.07), transparent 60%),
      radial-gradient(ellipse at 50% 50%, rgba(7,10,16,.2), rgba(4,7,14,.85));
    border: 1px solid rgba(207,231,255,.10);
    box-shadow: inset 0 0 80px rgba(4,7,14,.7);
    margin: 0; overflow: hidden;
  }
  .chart { position: absolute; inset: 0; width: 100%; height: 100%;
    display: block; }
  .chart .node { }
  .chart .node-link { display: block; cursor: pointer; }
  .chart .node use, .chart .node .halo { transition: opacity .5s ease; opacity: .85; }
  .chart .node .halo { opacity: .35; animation: breathe 6s ease-in-out infinite; }
  .chart .node:nth-of-type(odd) .halo { animation-delay: -2.4s; }
  .chart .node-label { opacity: 0; transition: opacity .4s ease, transform .4s ease; pointer-events: none;
    text-shadow: 0 1px 6px rgba(4,7,14,.9); transform: translateY(-2px); }
  .chart .node.is-active use { opacity: 1; }
  .chart .node.is-active .halo { opacity: .9; animation: none; }
  .chart .node.is-active .node-label { opacity: 1; transform: translateY(0); }
  .chart .node.is-linked use { opacity: 1; }
  .chart .node.is-linked .halo { opacity: .65; }
  .chart .node.is-linked .node-label { opacity: .55; transform: translateY(0); }
  .chart .node.node-inactive use { opacity: .45; }
  .chart .node.node-inactive .halo { opacity: .15; animation: none; }
  .chart .node.node-inactive .node-label { opacity: 0; }
  .atlas[data-active]:not([data-active=""]) .chart .node:not(.is-active):not(.is-linked) use { opacity: .25; }
  .atlas[data-active]:not([data-active=""]) .chart .node:not(.is-active):not(.is-linked) .halo { opacity: .08; }
  .atlas[data-active]:not([data-active=""]) .chart .node:not(.is-active):not(.is-linked) .node-label { opacity: 0; }
  .chart .rel { transition: stroke .5s ease, stroke-opacity .5s ease; }
  .chart .rel.is-lit { stroke: rgba(243,238,219,.7); stroke-dasharray: .4 .8; animation: relPulse 2.4s ease-in-out infinite; }
  .atlas[data-active]:not([data-active=""]) .chart .rel:not(.is-lit) { stroke: rgba(207,231,255,.06); }

  @keyframes breathe {
    0%, 100% { opacity: .35; }
    50%      { opacity: .65; }
  }
  @keyframes relPulse { 0%,100% { stroke-opacity: .55; } 50% { stroke-opacity: 1; } }

  .atlas-hint {
    text-align: center;
    font-family: "JetBrains Mono", monospace;
    font-size: .62rem;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: rgba(243,238,219,.30);
    margin: 16px 0 0;
    opacity: 1;
    transition: opacity .8s ease;
