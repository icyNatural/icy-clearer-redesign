    background-size: 360px 280px; animation: tw 9s ease-in-out infinite alternate; }
  @keyframes tw { from{opacity:.35;} to{opacity:.75;} }
  .paper { position: absolute; inset: 0; pointer-events: none; opacity: .04;
    background-image:
      repeating-linear-gradient(0deg, rgba(232,228,216,.6) 0, rgba(232,228,216,.6) 1px, transparent 1px, transparent 28px),
      repeating-linear-gradient(90deg, rgba(232,228,216,.4) 0, rgba(232,228,216,.4) 1px, transparent 1px, transparent 28px);
    mix-blend-mode: overlay;
  }
  .grain { position: absolute; inset: 0; opacity: .04; pointer-events: none;
    background-image: radial-gradient(rgba(255,255,255,.6) 1px, transparent 1px);
    background-size: 3px 3px; mix-blend-mode: overlay; }

  /* ── corner survey marks ──────────────────────────────────── */
