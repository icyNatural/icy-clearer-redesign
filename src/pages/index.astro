---
// HOMEPAGE — where two worlds collide.
// One living canvas: Clearer systems × Natural becoming.
// Generic drops never navigate without an explicit manifest href.

import HomeLayout from "../layouts/HomeLayout.astro";
import "../styles/foundation.css";
import "../styles/home.css";
import HeroCollision from "../components/home/HeroCollision.astro";
import DropField from "../components/home/DropField.astro";
import WorldDoors from "../components/home/WorldDoors.astro";
import PortfolioRelic from "../components/home/PortfolioRelic.astro";
import WorldPortal from "../components/home/WorldPortal.astro";
import SignalRow from "../components/home/SignalRow.astro";
---

<HomeLayout
  title="Icy Clearer — Two worlds, one life"
  description="Systems, photography, experiments, and living identity by Icy Clearer. Clear OS × Natural."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="environment" aria-hidden="true">
    <div class="environment__climate environment__climate--clear"></div>
    <div class="environment__climate environment__climate--nat"></div>
    <div class="environment__seam"></div>
    <div class="environment__grain"></div>
  </div>

  <main id="main" class="home-main" tabindex="-1">
    <HeroCollision />

    <div class="home-stage">
      <section class="home-block home-block--current" aria-label="Going crazy on">
        <DropField sectionId="current" />
      </section>

      <section class="home-block home-block--noticing" aria-label="Worth noticing">
        <DropField sectionId="noticing" />
      </section>

      <section class="home-block home-block--outside" aria-label="Outside with it">
        <DropField sectionId="outside" />
      </section>

      <section class="home-block home-block--doors" aria-label="Climate doorways">
        <WorldDoors />
      </section>

      <section class="home-block home-block--archive" aria-label="Archive and world">
        <div class="home-archive">
          <PortfolioRelic />
          <WorldPortal />
        </div>
      </section>
    </div>

    <footer class="home-foot" role="contentinfo">
      <div class="home-foot__inner">
        <SignalRow />
        <nav class="home-foot__nav" aria-label="Footer navigation">
          <a class="home-foot__link" href="/world.html">World</a>
          <a class="home-foot__link" href="/clear.html">Clear</a>
          <a class="home-foot__link" href="/natural.html">Natural</a>
          <a class="home-foot__link" href="/worlds.html">Two Worlds</a>
        </nav>
        <span class="home-foot__mark" aria-hidden="true">✦ Icy Clearer</span>
      </div>
    </footer>
  </main>

  <script is:inline>
    (function () {
      var doc = document.documentElement;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var finePointer = window.matchMedia('(pointer: fine)').matches;

      /* ── reveal on enter ── */
      var revealables = document.querySelectorAll('.drop, .world-door, .portfolio-relic, .world-portal');
      if ('IntersectionObserver' in window && !reduceMotion) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        revealables.forEach(function (el) { io.observe(el); });
      } else {
        revealables.forEach(function (el) { el.classList.add('is-in'); });
      }

      /* ── pointer depth (parallax) ── */
      if (finePointer && !reduceMotion) {
        var depthEls = Array.prototype.slice.call(document.querySelectorAll('[data-depth]'));
        var pending = false;
        var lastX = 0;
        var lastY = 0;

        var applyDepth = function () {
          pending = false;
          doc.style.setProperty('--px', String(lastX));
          doc.style.setProperty('--py', String(lastY));
          for (var i = 0; i < depthEls.length; i++) {
            var el = depthEls[i];
            var depth = parseFloat(el.getAttribute('data-depth') || '8');
            el.style.setProperty('--px', String(lastX));
            el.style.setProperty('--py', String(lastY));
            el.style.transform =
              'translate3d(' + (lastX * depth) + 'px, ' + (lastY * depth * 0.66) + 'px, 0)';
          }
        };

        document.addEventListener('pointermove', function (e) {
          lastX = (e.clientX / window.innerWidth - 0.5) * 2;
          lastY = (e.clientY / window.innerHeight - 0.5) * 2;
          if (!pending) {
            pending = true;
            requestAnimationFrame(applyDepth);
          }
        }, { passive: true });

        document.addEventListener('pointerleave', function () {
          lastX = 0; lastY = 0;
          applyDepth();
        });
      }

      /* ── drag fragments (desktop / fine pointer only) ── */
      if (finePointer && !reduceMotion) {
        var draggables = document.querySelectorAll('.drop--motion-drag');
        Array.prototype.forEach.call(draggables, function (el) {
          var startX = 0, startY = 0, curX = 0, curY = 0, dragging = false;
          var LIMIT = 90;

          el.addEventListener('pointerdown', function (e) {
            if (e.button !== 0) return;
            dragging = true;
            startX = e.clientX - curX;
            startY = e.clientY - curY;
            el.classList.add('is-dragging');
            el.setPointerCapture(e.pointerId);
          });
          el.addEventListener('pointermove', function (e) {
            if (!dragging) return;
            curX = Math.max(-LIMIT, Math.min(LIMIT, e.clientX - startX));
            curY = Math.max(-LIMIT * 0.6, Math.min(LIMIT * 0.6, e.clientY - startY));
            el.style.transform = 'translate3d(' + curX + 'px, ' + curY + 'px, 0)';
          });
          var end = function () {
            if (!dragging) return;
            dragging = false;
            el.classList.remove('is-dragging');
          };
          el.addEventListener('pointerup', end);
          el.addEventListener('pointercancel', end);
        });
      }

      /* ── video: play on view, toggle on button ── */
      var videos = document.querySelectorAll('.drop--video video');
      Array.prototype.forEach.call(videos, function (video) {
        var tile = video.closest('.drop');
        var btn = tile ? tile.querySelector('[data-video-toggle]') : null;
        if (btn) {
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (video.paused) {
              video.play().catch(function () {});
              btn.setAttribute('aria-pressed', 'true');
              btn.setAttribute('aria-label', btn.getAttribute('aria-label').replace(/^Play/, 'Pause'));
            } else {
              video.pause();
              btn.setAttribute('aria-pressed', 'false');
              btn.setAttribute('aria-label', btn.getAttribute('aria-label').replace(/^Pause/, 'Play'));
            }
          });
        }
        if (!reduceMotion && 'IntersectionObserver' in window) {
          var vio = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                video.play().catch(function () {});
                if (btn) btn.setAttribute('aria-pressed', 'true');
              } else {
                video.pause();
                if (btn) btn.setAttribute('aria-pressed', 'false');
              }
            });
          }, { threshold: 0.35 });
          vio.observe(video);
        }
      });

      /* ── atmosphere shift with scroll ── */
      if (!reduceMotion) {
        var ticking = false;
        window.addEventListener('scroll', function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var max = Math.max(1, document.body.scrollHeight - window.innerHeight);
            var t = Math.min(1, Math.max(0, window.scrollY / max));
            doc.style.setProperty('--scroll', String(t));
            ticking = false;
          });
        }, { passive: true });
      }
    })();
  </script>
</HomeLayout>
