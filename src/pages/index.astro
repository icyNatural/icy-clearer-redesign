  @media (max-width: 900px) { .nav a:not(.entry) { display: none; } .seal-sub { display: none; } }

  /* ── layout & plates ──────────────────────────────────────── */
  .institute { width: min(1180px, 100%); margin: 0 auto; padding: 56px 26px 100px; }
