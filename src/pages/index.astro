---
import "../styles/foundation.css";
import { worlds, artifacts, collections, signals, allEntities, lenses } from '../data/projects';

// ── Hidden applications (kept in data, hidden from UI) ─────────────────
const HIDDEN_IDS = new Set([
  'hoop-focus',
  'sample', 'beat', 'timeline', 'icy-natural', 'language', 'martial',
  'phases', 'motion', 'symbol', 'livingcycles',
  'reality', 'formation', 'humanity', 'woah', 'scenario-states', 'inquiry-engine',
]);

// ── Museum accession numbers ─────────────────────────────────────────
const catalog: Record<string, string> = {};
worlds.forEach((w, i)   => catalog[w.id] = `IN·W${String(i+1).padStart(2,'0')}`);
artifacts.forEach((a, i)=> catalog[a.id] = `IN·A${String(i+1).padStart(2,'0')}`);

const statusLabel: Record<string, string> = {
  live: 'Observable', forming: 'Forming', lab: 'In the Lab', soon: 'Awaited', archived: 'Archived', signal: 'Signal',
};

// ── ATLAS — every application in the ecosystem, as one star chart ────
// Node source: the lens registry (the whole ecosystem) + Icy Natural itself.
type AtlasApp = {
  id: string; title: string; philosophy: string; field: string;
  url: string; status: string; accent: string; glyph: string; group: string;
};

const atlasApps: AtlasApp[] = [
  { id: 'icy-natural', title: 'Icy Natural', philosophy: 'Becoming · Formation · Curation',
    field: 'A living archive of interests, experiences, and personal formation. A place for becoming slowly and collecting what matters.',
    url: '/natural.html', status: 'live', accent: '#8fc98a', glyph: '❦', group: 'instruments' },
  ...lenses.map(l => ({
    id: l.id, title: l.title, philosophy: l.philosophy, field: l.field,
    url: l.url, status: l.status as string, accent: l.accent, glyph: l.glyph, group: l.group as string,
  })),
];

// deterministic jittered grid that always fills the plate, however many
// applications are visible (hidden ones must not leave dead space)
type Node = AtlasApp & { x: number; y: number; external: boolean; route: string; type: string };

const visibleApps = atlasApps.filter(a => !HIDDEN_IDS.has(a.id));
const COLS = visibleApps.length <= 6 ? 3 : visibleApps.length <= 12 ? 4 : 5;
const ROWS = Math.max(1, Math.ceil(visibleApps.length / COLS));

const atlasPos = (i: number, total: number) => {
  const c = i % COLS, r = Math.floor(i / COLS);
  // items on the final row are centred so the chart never looks lopsided
  const inRow = Math.min(COLS, total - r * COLS);
  const stepX = 88 / COLS;
  const stepY = ROWS === 1 ? 0 : 78 / (ROWS - 1);
  const rowOffset = (COLS - inRow) * stepX / 2;
  const jx = ((i * 37) % 9) - 4;   // -4..4
  const jy = ((i * 53) % 7) - 3;   // -3..3
  return {
    x: Math.min(93, Math.max(7, 6 + rowOffset + stepX * (c + 0.5) + jx)),
    y: Math.min(92, Math.max(8, 11 + r * stepY + jy)),
  };
};

const nodes: Node[] = visibleApps
  .map((a, i) => ({
    ...a, ...atlasPos(i, visibleApps.length),
    route: a.url,
    external: a.url.startsWith('http'),
    type: 'artifact',
  }));

const nodeById: Record<string, Node> = Object.fromEntries(nodes.map(n => [n.id, n]));

// ── Relation lines — faint constellation threads within each family ──
const edges: { a: Node; b: Node }[] = [];
(['observatory', 'instruments'] as const).forEach(g => {
  const fam = nodes.filter(n => n.group === g);
  for (let i = 0; i < fam.length - 1; i++) edges.push({ a: fam[i], b: fam[i + 1] });
});
// a few cross-threads so the two families read as one sky
[['icy-clear-os', 'reality'], ['semantic-archaeology', 'language'], ['energy-engine', 'phases'],
 ['reality-capture', 'photogression'], ['hoop-focus', 'motion'], ['scenario-states', 'wonder']]
  .forEach(([a, b]) => { if (nodeById[a] && nodeById[b]) edges.push({ a: nodeById[a], b: nodeById[b] }); });

const linkOf     = (n: { route: string }) => n.route;
const isInactive = (n: { route: string }) => n.route === '#';

// ── Per-artifact "object identity" — each one is its own thing ───────
const objectKind: Record<string, string> = {
  'energy-engine':   'instr',
  'potent-library':  'shelf',
  'inquiry-engine':  'board',
  'pokedex-scanner': 'field',
  'reality-capture': 'evid',
  'playground':      'sandbox',
  'scenario-states': 'states',
  'hoop-focus':      'court',
  'photogression':   'series',
};

const ctaFor: Record<string, string> = {
  'pokedex-scanner': 'Open IcyVision →',
  'reality-capture': 'Open Reality Capture →',
  'energy-engine':   'Open Energy Engine →',
  'potent-library':  'Open Semantic Archaeology →',
  'inquiry-engine':  'Open Inquiry Engine →',
  'playground':      'Open Playground →',
  'scenario-states': 'Open Scenario States →',
  'hoop-focus':      'Open Hoop Focus →',
  'photogression':   'Open Photogression →',
};


// ── Field-journal entries (signals presented as inked notes) ─────────
const today = new Date();
const dayLabel = today.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
const buildStamp = today.toISOString().slice(0, 10);
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Icy Natural — See clearly. Become slowly.</title>
  <meta name="description" content="An observatory of systems, language, energy, and becoming." />
  <meta name="theme-color" content="#06090f" />
  <meta property="og:title" content="Icy Natural — See clearly. Become slowly." />
  <meta property="og:description" content="An observatory of systems, language, energy, and becoming." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Icy Natural — See clearly. Become slowly." />
  <meta name="twitter:description" content="An observatory of systems, language, energy, and becoming." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=IM+FELL+English:ital@0;1&family=JetBrains+Mono:wght@300;400;500&family=Caveat:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<!-- celestial wash -->
<div class="sky" aria-hidden="true">
  <div class="nebula a"></div>
  <div class="nebula b"></div>
  <div class="starfield"></div>
  <div class="paper"></div>
  <div class="grain"></div>
</div>

<header class="bar">
  <a href="/" class="seal" aria-label="Icy Clearer — home">
    <span class="seal-mark">✦</span>
    <span class="seal-words">
      <span class="seal-name">Icy Clearer</span>
    </span>
  </a>
  <nav class="nav" aria-label="Primary">
    <a href="#atlas">Map</a>
    <a href="#objects">Tools</a>
    <a class="entry" href="#atlas">Enter →</a>
  </nav>
</header>

<main id="main" class="institute" tabindex="-1">

  <!-- ╔══ HALL OF ENTRY — opening plate ══════════════════════════════ -->
  <section id="hall" class="hall">
    <p class="kicker"><span class="pulse"></span> <span id="live-date" data-live-date>{dayLabel}</span></p>

    <h1 class="hall-title">
      <span class="line">See clearly.</span>
      <span class="line"><em>Become slowly.</em></span>
    </h1>

    <p class="hall-lead">
      An observatory of systems, language, energy, and becoming.
    </p>
    <div class="hall-rule" aria-hidden="true"></div>
  </section>

  <!-- ╔══ ATLAS — celestial chart, mostly anonymous ═════════════════ -->

  <section id="atlas" class="plate atlas-plate">
    <header class="plate-head">
      <span class="plate-no">Plate I</span>
      <h2 class="plate-title">The Atlas</h2>
      <p class="plate-rule">A collection of interactive applications exploring systems, language, observation, and becoming.</p>
      <p class="plate-instruction">Choose an application below.</p>
    </header>

    {/* mobile: selected application sits in normal flow, above the map */}
    <div class="atlas-selected" id="atlas-selected" aria-live="polite"></div>




    <figure class="atlas constellation" id="atlas-figure" data-active="">
      <svg class="chart" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <radialGradient id="halo" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="currentColor" stop-opacity=".55"/>
            <stop offset="60%" stop-color="currentColor" stop-opacity=".08"/>
            <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
          </radialGradient>
          {/* sigils — each one is a tiny piece of celestial print */}
          <symbol id="sig-clear" viewBox="-10 -10 20 20">
            <g fill="none" stroke="currentColor" stroke-width=".9" stroke-linecap="round">
              <line x1="0" y1="-8" x2="0" y2="8"/>
              <line x1="-8" y1="0" x2="8" y2="0"/>
              <line x1="-5.7" y1="-5.7" x2="5.7" y2="5.7"/>
              <line x1="-5.7" y1="5.7" x2="5.7" y2="-5.7"/>
              <path d="M0 -8 L-1.8 -6 M0 -8 L1.8 -6 M0 8 L-1.8 6 M0 8 L1.8 6 M-8 0 L-6 -1.8 M-8 0 L-6 1.8 M8 0 L6 -1.8 M8 0 L6 1.8"/>
            </g>
            <circle r="1.4" fill="currentColor"/>
          </symbol>
          <symbol id="sig-natural" viewBox="-10 -10 20 20">
            <g fill="none" stroke="currentColor" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round">
              <line x1="0" y1="-9" x2="0" y2="9"/>
              <path d="M0 -3 Q-5 -4 -5.4 -8.2 Q-2 -7.2 0 -3 Z"/>
              <path d="M0 -3 Q5 -4 5.4 -8.2 Q2 -7.2 0 -3 Z"/>
              <path d="M0 3 Q-6 2 -6.4 -2.2 Q-2 -1.2 0 3 Z"/>
              <path d="M0 3 Q6 2 6.4 -2.2 Q2 -1.2 0 3 Z"/>
            </g>
            <circle cx="0" cy="9" r="1" fill="currentColor"/>
          </symbol>
          <symbol id="sig-energy" viewBox="-10 -10 20 20">
            <g fill="none" stroke="currentColor" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2.5 -8 L-3.5 1.2 L0.2 1.2 L-2.5 8 L4 -1.2 L0.3 -1.2 Z"/>
            </g>
          </symbol>
          <symbol id="sig-inquiry" viewBox="-10 -10 20 20">
            <g fill="none" stroke="currentColor" stroke-width=".9" stroke-linecap="round">
              <path d="M-5 -3 C-5 -7 5 -7 5 -3 C5 0 0 1 0 4"/>
              <circle cx="0" cy="7" r=".9" fill="currentColor" stroke="none"/>
            </g>
          </symbol>
          <symbol id="sig-library" viewBox="-10 -10 20 20">
            <g fill="none" stroke="currentColor" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M-7 0 L-7 5 L7 5 L7 0 Z"/>
              <line x1="-7" y1="2" x2="7" y2="2"/>
              <path d="M-6 -5 L-6 0 L6 0 L6 -5 Z"/>
              <line x1="-6" y1="-3" x2="6" y2="-3"/>
            </g>
          </symbol>
          <symbol id="sig-diary" viewBox="-10 -10 20 20">
            <g fill="none" stroke="currentColor" stroke-width=".8" stroke-linecap="round">
              <path d="M0 8 C-1 4 -1 0 0 -7"/>
              <path d="M0 6 L-3 5 M0 4 L-3.5 3 M0 2 L-4 1 M0 0 L-4 -1 M0 -2 L-3.5 -3 M0 -4 L-3 -5"/>
            </g>
          </symbol>
          <symbol id="sig-reality" viewBox="-10 -10 20 20">
            <g fill="none" stroke="currentColor" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M-4 -7 L4 -7 L5 -1 L0 8 L-5 -1 Z"/>
              <line x1="0" y1="-1" x2="0" y2="5"/>
              <circle cx="0" cy="1.5" r=".9" fill="currentColor" stroke="none"/>
            </g>
          </symbol>
          <symbol id="sig-scanner" viewBox="-10 -10 20 20">
            <g fill="none" stroke="currentColor" stroke-width=".8">
              <circle r="7.5"/>
              <line x1="-9" y1="0" x2="-5" y2="0"/>
              <line x1="9" y1="0" x2="5" y2="0"/>
              <line x1="0" y1="-9" x2="0" y2="-5"/>
              <line x1="0" y1="9" x2="0" y2="5"/>
            </g>
            <circle r="1.2" fill="currentColor"/>
          </symbol>
        </defs>

        {/* drifting field stars */}
        {Array.from({length: 60}).map((_, k) => {
          const x = (k * 53.7) % 100; const y = (k * 31.3 + 11) % 100;
          const r = (k % 7 === 0) ? .18 : .09;
          return <circle cx={x} cy={y} r={r} fill="rgba(243,238,219,.45)" />;
        })}

        {/* relation lines — faint until illuminated */}
        {edges.map(({ a, b }) => (
          <line class="rel" data-a={a.id} data-b={b.id}
                x1={a.x} y1={a.y} x2={b.x} y2={b.y}
                stroke="rgba(207,231,255,.18)" stroke-width=".12"
                stroke-dasharray=".5 1.1" />
        ))}

        {/* nodes — sigil or glyph + halo, no permanent text */}
        {nodes.map(n => {
          const sigMap: Record<string,string> = {
            'energy-engine':'sig-energy','inquiry-engine':'sig-inquiry',
            'semantic-archaeology':'sig-library','language':'sig-library',
            'reality-capture':'sig-diary','reality':'sig-reality',
            'sense':'sig-scanner','icy-clear-os':'sig-clear','icy-natural':'sig-natural',
          };
          const sig = sigMap[n.id];
          const size = 5.2;
          const halo = 9;
          const inactive = isInactive(n);
          return (
            <g class={`node ${inactive ? 'node-inactive' : ''}`} data-id={n.id} transform={`translate(${n.x} ${n.y})`}
               style={`color:${n.accent ?? '#cfe7ff'}`}>
              <circle class="ripple" r={halo} fill="none" stroke="currentColor" stroke-width=".6" opacity="0"/>
              <circle class="halo" r={halo} fill="url(#halo)" opacity=".35"/>
              {sig
                ? <use href={`#${sig}`} x={-size/2} y={-size/2} width={size} height={size}/>
                : <text class="node-glyph" x="0" y="0" text-anchor="middle" dominant-baseline="central"
                        font-size="4.4" fill="currentColor">{n.glyph}</text>}
            </g>
          );
        })}
      </svg>

      {/* large invisible HTML hit targets — stars are easier to touch than to aim at */}
      <div class="hit-targets">
        {nodes.map(n => {
          const inactive = isInactive(n);
          const href = linkOf(n);
          if (inactive) {
            return (
              <button type="button" class="hit-target" data-id={n.id} data-inactive="1"
                      aria-label={n.title}
                      style={`left:${n.x}%; top:${n.y}%`}/>
            );
          }
          return (
            <a class="hit-target" href={href} data-id={n.id}
               target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined}
               aria-label={n.title}
               style={`left:${n.x}%; top:${n.y}%`}/>
          );
        })}
      </div>


      {/* field cards — whispers that appear when a node is touched */}
      <div class="field-cards">
        {nodes.map(n => {
          const inactive = isInactive(n);
          return (
            <div class="field-card"
                 data-card={n.id}
                 data-nx={n.x}
                 data-ny={n.y}
                 style={`--accent:${n.accent ?? '#cfe7ff'}`}>
              <div class="fc-inner">
                <div class="fc-head">
                  <span class="fc-emoji">{n.glyph}</span>
                  <span class="fc-title">{n.title}</span>
                </div>
                <p class="fc-tag">{n.philosophy}</p>
                <p class="fc-field">{n.field}</p>
              {inactive
                ? <span class="fc-cta fc-cta-soon">In the lab</span>
                : <a class="fc-cta" href={n.route} target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined}>Enter →</a>}
              </div>
            </div>
          );
        })}
      </div>


    </figure>

    

    {/* mobile index sheet — every object visible on the chart, one tap away */}
    <nav class="atlas-index" aria-label="Atlas index">
      <span class="atlas-index-label">Index</span>
      <ul>
        {nodes.map(n => {
          const inactive = isInactive(n);
          const href = linkOf(n);
          if (inactive) {
            return (
              <li>
                <button type="button" class="atlas-index-chip" data-jump={n.id} data-inactive="1">
                  <span class="dot" style={`background:${n.accent ?? '#cfe7ff'}`}></span>
                  {n.title}
                </button>
              </li>
            );
          }
          return (
            <li>
              <button type="button" class="atlas-index-chip" data-jump={n.id}
                      data-href={href}
                      data-external={n.external ? '1' : '0'}>
                <span class="dot" style={`background:${n.accent ?? '#cfe7ff'}`}></span>
                {n.title}
              </button>
            </li>
          );
        })}
      </ul>
    </nav>




    <script is:inline>
      (function(){
        var fig = document.getElementById('atlas-figure');
        if (!fig) return;
        var reduceMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        var scrollMode = function(){ return reduceMotion ? 'auto' : 'smooth'; };
        var nodes = fig.querySelectorAll('.node');
        var rels  = fig.querySelectorAll('.rel');
        var cards = fig.querySelectorAll('.field-card');
        var hits  = fig.querySelectorAll('.hit-target');
        var isTouchEnv = (window.matchMedia && window.matchMedia('(hover: none)').matches);
        var armed = null;   // id revealed but not yet entered (touch)
        var locked = null;  // last selected id stays highlighted

        function setActive(id){
          fig.setAttribute('data-active', id || '');
          nodes.forEach(function(g){
            g.classList.toggle('is-active', !!id && g.getAttribute('data-id') === id);
          });
          var connected = new Set();
          rels.forEach(function(line){
            var a = line.getAttribute('data-a'), b = line.getAttribute('data-b');
            var on = id && (a === id || b === id);
            line.classList.toggle('is-lit', !!on);
            if (on) { connected.add(a); connected.add(b); }
          });
          nodes.forEach(function(g){
            var nid = g.getAttribute('data-id');
            g.classList.toggle('is-linked', !!id && nid !== id && connected.has(nid));
          });
          cards.forEach(function(c){
            var match = !!id && c.getAttribute('data-card') === id;
            if (match && !isFlowLayout()) { positionCard(c); }
            c.classList.toggle('is-shown', match);
          });
          renderFlowPanel(id);
          if (id) {
            fig.classList.add('is-locked');
          } else {
            setTimeout(function(){
              if (!fig.getAttribute('data-active')) fig.classList.remove('is-locked');
            }, 120);
          }
        }

        // ── mobile: render the selection into normal document flow ──
        var flowPanel = document.getElementById('atlas-selected');
        var flowMQ = window.matchMedia('(max-width: 900px)');
        function isFlowLayout(){ return flowMQ.matches; }
        function renderFlowPanel(id){
          if (!flowPanel) return;
          if (!isFlowLayout() || !id) {
            flowPanel.classList.remove('is-shown');
            flowPanel.innerHTML = '';
            return;
          }
          var src = null;
          cards.forEach(function(c){ if (c.getAttribute('data-card') === id) src = c; });
          if (!src) { flowPanel.classList.remove('is-shown'); flowPanel.innerHTML = ''; return; }
          var accent = src.style.getPropertyValue('--accent') || '#cfe7ff';
          flowPanel.style.setProperty('--accent', accent);
          var inner = src.querySelector('.fc-inner');
          flowPanel.innerHTML = inner ? inner.outerHTML : '';
          var body = flowPanel.querySelector('.fc-inner');
          if (body) {
            var tie = document.createElement('p');
            tie.className = 'fc-tie';
            tie.innerHTML = '<span class="tie-dot"></span><span>selected in atlas</span><span class="tie-line"></span>';
            body.appendChild(tie);
          }
          flowPanel.classList.add('is-shown');
          // bring the panel into view only if it isn't already
          var r = flowPanel.getBoundingClientRect();
          var safeTop = 72, safeBottom = window.innerHeight - 110;
          if (r.top < safeTop || r.bottom > safeBottom) {
            var target = window.scrollY + r.top - safeTop;
            window.scrollTo({ top: Math.max(0, target), behavior: scrollMode() });
          }
        }
        flowMQ.addEventListener('change', function(){ renderFlowPanel(fig.getAttribute('data-active') || ''); });


        // ── cards take interaction priority while open ──
        cards.forEach(function(c){
          c.addEventListener('click', function(ev){ ev.stopPropagation(); });
        });

        // ── soft proximity glow (no commitment, just discoverability) ──
        function setNear(ids){
          var set = new Set(ids || []);
          nodes.forEach(function(g){
            var nid = g.getAttribute('data-id');
            // don't override the locked/active state
            if (g.classList.contains('is-active') || g.classList.contains('is-linked')) {
              g.classList.remove('is-near');
              return;
            }
            g.classList.toggle('is-near', set.has(nid));
          });
        }
        function nearestHits(px, py, max, radius){
          var ranked = [];
          hits.forEach(function(el){
            var r = el.getBoundingClientRect();
            var cx = r.left + r.width/2, cy = r.top + r.height/2;
            var d = Math.hypot(cx - px, cy - py);
            if (d <= radius) ranked.push({ el: el, d: d, id: el.getAttribute('data-id') });
          });
          ranked.sort(function(a,b){ return a.d - b.d; });
          return ranked.slice(0, max);
        }

        function positionCard(card){
          var figRect = fig.getBoundingClientRect();
          var nx = parseFloat(card.getAttribute('data-nx')) || 50;
          var ny = parseFloat(card.getAttribute('data-ny')) || 50;
          var cxV = figRect.left + (nx/100) * figRect.width;
          var cyV = figRect.top  + (ny/100) * figRect.height;
          var prevVis = card.style.visibility;
          card.style.visibility = 'hidden';
          card.style.transform = 'none';
          card.classList.add('is-measuring');
          var cw = card.offsetWidth, ch = card.offsetHeight;
          card.classList.remove('is-measuring');
          card.style.visibility = prevVis || '';

          var pad = 10, gap = 18;
          var vw = window.innerWidth, vh = window.innerHeight;
          var candidates = [
            { name:'right',  l: cxV + gap,            t: cyV - ch/2 },
            { name:'left',   l: cxV - gap - cw,       t: cyV - ch/2 },
            { name:'below',  l: cxV - cw/2,           t: cyV + gap },
            { name:'above',  l: cxV - cw/2,           t: cyV - gap - ch },
          ];
          var chosen = null;
          for (var i=0;i<candidates.length;i++){
            var c = candidates[i];
            if (c.l >= pad && c.l + cw <= vw - pad &&
                c.t >= pad && c.t + ch <= vh - pad) { chosen = c; break; }
          }
          if (!chosen) chosen = { name:'below', l: cxV - cw/2, t: cyV + gap };
          var lV = Math.max(pad, Math.min(chosen.l, vw - pad - cw));
          var tV = Math.max(pad, Math.min(chosen.t, vh - pad - ch));
          card.style.setProperty('--fx', (lV - figRect.left) + 'px');
          card.style.setProperty('--fy', (tV - figRect.top)  + 'px');
        }

        window.addEventListener('resize', function(){
          if (!isFlowLayout()) cards.forEach(function(c){ if (c.classList.contains('is-shown')) positionCard(c); });
        });
        window.addEventListener('scroll', function(){
          if (!isFlowLayout()) cards.forEach(function(c){ if (c.classList.contains('is-shown')) positionCard(c); });
        }, { passive: true });

        hits.forEach(function(el){
          var id = el.getAttribute('data-id');
          var inactive = el.getAttribute('data-inactive') === '1';
          el.addEventListener('pointerenter', function(){ if (!isTouchEnv) setActive(id); });
          el.addEventListener('pointerleave', function(){ if (!isTouchEnv && locked !== id) setActive(locked || ''); });
          el.addEventListener('focus', function(){ setActive(id); });

          el.addEventListener('click', function(ev){
            if (inactive) { ev.preventDefault(); locked = id; armed = id; setActive(id); return; }
            if (isTouchEnv) {
              if (armed === id) { armed = null; return; } // second tap → follow link
              ev.preventDefault();
              armed = id; locked = id; setActive(id);
            } else {
              locked = id;
            }
          });
        });

        // ── proximity glow on hover (desktop) ──
        if (!isTouchEnv) {
          fig.addEventListener('pointermove', function(ev){
            if (locked) return; // committed view wins
            var near = nearestHits(ev.clientX, ev.clientY, 3, 140);
            setNear(near.map(function(x){ return x.id; }));
          });
          fig.addEventListener('pointerleave', function(){ if (!locked) setNear([]); });
        }

        // ── proximity glow on touch drag (mobile) ──
        fig.addEventListener('touchmove', function(ev){
          var t = ev.touches[0]; if (!t) return;
          var near = nearestHits(t.clientX, t.clientY, 4, 160);
          setNear(near.map(function(x){ return x.id; }));
        }, { passive: true });
        fig.addEventListener('touchend',   function(){ setNear([]); }, { passive: true });
        fig.addEventListener('touchcancel',function(){ setNear([]); }, { passive: true });

        // ── magnetic snap — taps near a node activate the nearest one ──
        fig.addEventListener('click', function(ev){
          if (ev.target.closest('.hit-target')) return;
          if (ev.target.closest('.field-card')) return; // let card links work
          var near = nearestHits(ev.clientX, ev.clientY, 1, 120);
          if (near.length) {
            ev.preventDefault();
            near[0].el.focus();
            near[0].el.click();
          } else {
            armed = null; locked = null; setActive(''); setNear([]);
          }
        });

        // ── bottom-sheet index → jump straight to a node ──
        var chips = document.querySelectorAll('.atlas-index-chip');
        chips.forEach(function(chip){
          chip.addEventListener('click', function(ev){
            var id = chip.getAttribute('data-jump');
            if (!id) return;
            locked = id; armed = id; setActive(id);
            // scroll the chart into view so the user sees the highlight
            if (!isFlowLayout()) fig.scrollIntoView({ behavior: scrollMode(), block: 'center' });
            // mark active chip
            chips.forEach(function(c){ c.classList.toggle('is-active', c === chip); });
          });
        });

        document.addEventListener('click', function(ev){
          if (!fig.contains(ev.target) && !ev.target.closest('.atlas-index')) {
            armed = null; locked = null; setActive(''); setNear([]);
            chips.forEach(function(c){ c.classList.remove('is-active'); });
          }
        });

        // ── hint & first-load pulse ───────────────────────────
        var hint = document.getElementById('atlas-hint');
        var hintFaded = false;
        var introEl = null;
        function dismissHint(){
          if (!hint || hintFaded) return;
          hintFaded = true;
          hint.classList.add('is-faded');
          if (introEl) { introEl.classList.remove('is-intro'); introEl = null; }
        }
        function touchAnywhere(){ dismissHint(); }
        fig.addEventListener('click', touchAnywhere, {once:true});
        fig.addEventListener('touchstart', touchAnywhere, {once:true});
        var indexNav = document.querySelector('.atlas-index');
        if (indexNav) { indexNav.addEventListener('click', touchAnywhere, {once:true}); }

        if (hint) {
          hint.textContent = isTouchEnv ? 'Tap a star to inspect.' : 'Hover a star to inspect.';
        }

        setTimeout(function(){
          if (hintFaded) return;
          var first = nodes[0];
          if (first) {
            first.classList.add('is-intro');
            introEl = first;
            setTimeout(function(){
              if (introEl === first) { first.classList.remove('is-intro'); introEl = null; }
            }, 3600);
          }
        }, 700);
      })();
    </script>


