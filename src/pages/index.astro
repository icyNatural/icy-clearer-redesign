<script is:inline>
  (function(){
    var el = document.getElementById('live-date');
    if (!el) return;
    var update = function(){
      var d = new Date();
      el.textContent = d.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase();
    };
    update();
    setInterval(update, 60000);
  })();
</script>

<script is:inline>
  /* Plate III — masonry placement so paired artifacts keep natural heights */
  (function(){
    var grid = document.querySelector('.objects');
    if (!grid) return;
    var ROW = 8, GAP = 26;
    function layout(){
      var wide = window.matchMedia('(min-width: 901px)').matches;
      var items = grid.querySelectorAll(':scope > .obj');
      if (!wide) {
        grid.classList.remove('is-masonry');
        items.forEach(function(it){ it.style.gridRowEnd = ''; });
        return;
      }
      grid.classList.add('is-masonry');
      items.forEach(function(it){
        it.style.gridRowEnd = '';
        var h = it.getBoundingClientRect().height;
        it.style.gridRowEnd = 'span ' + Math.ceil((h + GAP) / ROW);
      });
    }
    layout();
    window.addEventListener('load', layout);
    window.addEventListener('resize', function(){
      clearTimeout(window.__objT); window.__objT = setTimeout(layout, 120);
    });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(layout);
  })();
</script>

</body>
</html>
