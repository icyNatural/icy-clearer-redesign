  .plate-rule { grid-column: 2; margin: 8px 0 0; color: rgba(232,228,216,.65); font-style: italic; font-size: 1.02rem; max-width: 60ch; line-height: 1.5; }
  .plate-instruction { grid-column: 2; margin: 12px 0 0; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: .68rem; letter-spacing: .28em; text-transform: uppercase; color: rgba(207,231,255,.7); }

  /* ── HALL ─────────────────────────────────────────────────── */
  .hall { padding: 30px 0 24px; }
