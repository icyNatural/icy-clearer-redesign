                  <line x1="140" y1="46" x2="194" y2="46" stroke="#cfe7ff" stroke-width=".5" opacity=".3"/>
                  <path d="M 18 24 L 66 42" stroke="#cfe7ff" stroke-width=".5" opacity=".25" fill="none"/>
                  <path d="M 18 68 L 66 50" stroke="#cfe7ff" stroke-width=".5" opacity=".25" fill="none"/>
                  <path d="M 134 42 L 182 22" stroke="#cfe7ff" stroke-width=".5" opacity=".25" fill="none"/>
                  <path d="M 134 50 L 182 70" stroke="#cfe7ff" stroke-width=".5" opacity=".25" fill="none"/>
                </svg>
                <div class="series-strip">
                  {['Framing','Light','Distance','Stillness'].map((n) => (
                    <span class="series-cell">{n}</span>
                  ))}
                </div>
                <span class="series-stamp">types of seeing · lens study</span>
              </div>
              <div class="series-meta">
                {tag}
                <h3 class="obj-name">{a.title}</h3>
                <p class="obj-prose">{a.blurb}</p>
                <p class="series-spec">A lens that teaches capture · looking as practice.</p>
                <span class="obj-cta">{cta}</span>
              </div>
            </div>
          </a>
        );


        // ── EVIDENCE (Reality Capture) ─────────────────────────
        return (
          <a href={linkOf(a)} class={common} style={style} target={a.external?'_blank':undefined} rel={a.external?'noopener':undefined}>
            <div class="evid-frame">
              <div class="evid-strip" aria-hidden="true">
                <span class="evid-label">EVIDENCE · {catalog[a.id]}</span>
                <div class="evid-frames">
                  {Array.from({length: 4}).map((_, k) => (
                    <div class="evid-cell">
                      <span class="evid-num">{String(k+1).padStart(2,'0')}</span>
                      <span class="evid-mark"></span>
                    </div>
                  ))}
                </div>
                <span class="evid-foot">unprocessed · pre-name · chain of custody open</span>
              </div>
              <div class="evid-meta">
                {tag}
                <h3 class="obj-name">{a.title}</h3>
                <p class="obj-prose">{a.blurb}</p>
                <p class="evid-spec">Evidence archive · notation for what is, before interpretation.</p>
                <span class="obj-cta">{cta}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>


  <!-- ╔══ COLOPHON ═════════════════════════════════════════════ -->
  <footer class="colophon">
    <div class="col-left">
