    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes introGlow {
    0%, 100% { opacity: .35; transform: scale(1); }
    50%      { opacity: .75; transform: scale(1.25); }
  }
  @keyframes introRipple {
