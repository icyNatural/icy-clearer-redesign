---
import "../styles/foundation.css";
import MediaRoom from '../components/MediaRoom.astro';
import NaturalObjects from '../components/NaturalObjects.astro';
import NaturalField from '../components/NaturalField.astro';
import manifest from '../data/media/natural.json?raw';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const raw = import.meta.env.DEV && import.meta.env.MODE === 'author'
  ? readFileSync(resolve(process.cwd(), 'src/data/media/natural.json'), 'utf8')
  : manifest;
const items = JSON.parse(raw);
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Natural — Icy Clearer</title>
  <meta name="description" content="A living field of play, voice, observation, making, archive, and now." />
  <meta name="theme-color" content="#080d0c" />
  <meta property="og:title" content="Natural — Icy Clearer" />
  <meta property="og:description" content="Signals overlap. Artifacts stay themselves." />
  <meta property="og:type" content="website" />
</head>
<body class="natural-document">
  <a class="skip-link" href="#main">Skip to content</a>
  <a class="world-back" href="/" aria-label="Back home">← HOME</a>

  <main id="main" class="natural-shell" tabindex="-1">
    <NaturalField items={items} />
  </main>

  <MediaRoom room="natural" overlay />
  <NaturalObjects />
</body>
</html>
