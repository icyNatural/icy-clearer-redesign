---
/**
 * ICY CLEAR / companion to How I See It.
 * A scroll-directed spatial essay, not a tool or a universal claim about intelligence.
 * A single architectural world changes meaning across six chapters.
 */
const chapters = [
  { id:'perception', number:'01', title:'Perception', eyebrow:'The encounter', statement:'Something is here before I understand what it means.', copy:'I encounter a place, a sound, a person, a problem, a pattern. At first, I only have a partial reading of it. The world is not limited to what I notice.', note:'The passage exists. I have not seen it yet.' },
  { id:'recognition', number:'02', title:'Recognition', eyebrow:'The opening', statement:'I begin to see what was already possible.', copy:'A relationship comes into focus. A function becomes visible. Something I thought was a wall turns out to contain an opening. The environment may be unchanged; my perception of its affordances has changed.', note:'The passage becomes visible. Nothing physical had to be built.' },
  { id:'simulation', number:'03', title:'Simulation', eyebrow:'The possible', statement:'I can explore a future before it happens.', copy:'From an opening, possibilities begin to branch. I can imagine routes, test consequences, and compare what might happen—while remembering that imagination is a model, not the world itself.', note:'Several crossings appear as projections, not yet as facts.' },
  { id:'orchestration', number:'04', title:'Orchestration', eyebrow:'The actual', statement:'A possibility becomes an arrangement of real things.', copy:'I coordinate knowledge, tools, people, time, and actions. An imagined crossing becomes something that can actually carry weight. The distance between a thought and an outcome is filled with work, constraints, and feedback.', note:'One projected route takes physical form.' },
  { id:'transformation', number:'05', title:'Transformation', eyebrow:'The change', statement:'Acting can alter both the world and my abilities.', copy:'An action changes the environment. It may also change what I can do next. The new crossing does not merely answer a question: it creates access, new encounters, and the possibility of different questions.', note:'A place that was unreachable can now be reached.' },
  { id:'generativity', number:'06', title:'Generativity', eyebrow:'The continuation', statement:'What I make can open futures I never planned.', copy:'A capability can be passed on, adapted, and recombined. Other people—or systems—may discover uses I never imagined. I am interested in what can continue developing without my constant direction.', note:'New routes grow beyond the original plan.' },
];
---
<!doctype html>
<html lang="en" data-scene="perception">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#080d12" />
  <meta name="description" content="Generative Reality — how I move from perception and recognition to simulation, orchestration, transformation, and new possibility. A personal evolving framework." />
  <meta property="og:title" content="Generative Reality — ICY CLEAR" />
  <meta property="og:description" content="Sometimes I discover what was possible. Sometimes I change what can become possible." />
  <title>Generative Reality — How I See More | ICY CLEAR</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/clear/fonts/bodoni.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/clear/fonts/barlow.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
<a href="#narrative" class="skip">Skip to the framework</a>
<header class="site-head">
  <a class="wordmark" href="/clear.html">ICY <strong>CLEAR</strong><span> / HOW I SEE IT</span></a>
  <nav aria-label="Other perspectives"><a href="/clear.html">Continuous Development</a><a href="#questions">The questions</a></nav>
</header>
<main>
  <section class="hero" aria-labelledby="hero-title">
    <p class="index">ANOTHER PERSONAL LENS <span>—</span> A FRAMEWORK IN MOTION</p>
    <h1 id="hero-title">Generative<br /><em>Reality.</em></h1>
    <p class="hero-lead">I keep wondering how much more I might see—not simply by learning more facts, but by learning to recognize what things <em>could become.</em></p>
    <div class="hero-tail"><a href="#narrative">Follow the transition <span aria-hidden="true">↓</span></a><span>06 connected movements / one changing world</span></div>
    <div class="hero-ghost" aria-hidden="true">BECOMING</div>
  </section>

  <section class="opening shell" aria-labelledby="opening-title">
    <span class="side-index">A DISTINCTION / 00</span>
    <div>
      <h2 id="opening-title">Seeing more does not always mean <em>creating more.</em></h2>
      <p>Sometimes a possibility was already there, and I simply didn't recognize it. Sometimes a new ability, tool, or action changes what is actually possible. Those are not the same event.</p>
      <p class="quiet">This is how I'm currently examining the relationship between perception, possibility, and creation. It isn't a hierarchy everyone must follow, and it isn't a claim that imagination alone changes reality.</p>
    </div>
  </section>

  <div id="narrative" class="narrative" aria-label="Six stages in one evolving spatial scene">
    <div class="stage" aria-hidden="true">
      <div class="ambient ambient-a"></div><div class="ambient ambient-b"></div>
      <div class="world">
        <div class="world-plate"></div>
        <div class="back-horizon"></div>
        <div class="chasm"></div>
        <div class="near-bank"></div><div class="far-bank"></div>
        <div class="gate"><div class="gate-frame"></div><div class="gate-inside"></div><div class="gate-seam"></div></div>
        <div class="searchlight"></div>
        <div class="ghost-bridge ghost-a"></div><div class="ghost-bridge ghost-b"></div><div class="ghost-bridge ghost-c"></div>
        <div class="solid-bridge"><div class="bridge-top"></div><div class="bridge-edge"></div><div class="bridge-support support-a"></div><div class="bridge-support support-b"></div></div>
        <div class="arrival-light"></div>
        <div class="branch-path branch-a"></div><div class="branch-path branch-b"></div><div class="branch-path branch-c"></div>
        <div class="far-gate"></div>
      </div>
      <div class="stage-chrome"><span>ONE ENVIRONMENT / CHANGING ACCESS</span><span>SCROLL TO TRAVEL ↓</span></div>
      <div class="stage-caption"><span data-stage-number>01 / 06</span><strong data-stage-note>The passage exists. I have not seen it yet.</strong></div>
    </div>
    <div class="chapters">
      {chapters.map(chapter => (
        <section class="chapter" id={chapter.id} data-scene={chapter.id} aria-labelledby={chapter.id + '-title'}>
          <div class="chapter-inner">
            <p class="chapter-kicker">{chapter.number} / 06 — {chapter.eyebrow}</p>
            <h2 id={chapter.id + '-title'}>{chapter.title}<span class="period">.</span></h2>
            <blockquote>{chapter.statement}</blockquote>
            <p>{chapter.copy}</p>
            <div class="chapter-bridge" aria-hidden="true"><span></span><span>THE SAME WORLD, A DIFFERENT POSSIBILITY</span></div>
          </div>
        </section>
      ))}
    </div>
  </div>

  <section class="affordances shell" aria-labelledby="affordance-title">
    <p class="side-index">THE TURN / SEEN ≠ MADE</p>
    <div class="affordance-copy">
      <h2 id="affordance-title">The difference between<br /><em>an opening</em> and <em>a bridge.</em></h2>
      <div class="contrast">
        <article><span>01 — RECOGNIZED</span><h3>Perceived possibility</h3><p>An opening may already exist. Seeing it changes my access to information, not necessarily the physical world.</p></article>
        <article><span>02 — MADE</span><h3>Changed possibility</h3><p>Building a crossing changes the environment. Actions that weren't previously feasible may now become feasible.</p></article>
      </div>
      <blockquote class="turning-point">“You might not be expanding reality every time you discover something. You may be expanding your <em>resolution of possibility</em>—your ability to recognize what was already there.”</blockquote>
      <p class="after-turn">But once I act on those discoveries, I can begin changing what actually becomes possible.</p>
      <p class="affordance-definition">An <strong>actual affordance</strong> is an action available through the relationship between a person and an environment, whether or not it is noticed. A <strong>perceived affordance</strong> is one I recognize. Learning may reveal an existing possibility; acting may change which possibilities are actually available.</p>
    </div>
  </section>

  <section class="questions" id="questions" aria-labelledby="questions-title">
    <div class="shell">
      <p class="side-index">GENERATIVE INTELLIGENCE / QUESTIONS TO KEEP OPEN</p>
      <h2 id="questions-title">And what does<br /><em>intelligence make possible?</em></h2>
      <ol>
        <li><span>01</span><p>How much of the <em>possible</em> can an intelligence mentally explore?</p><small>SIMULATION</small></li>
        <li><span>02</span><p>How much of the <em>actual</em> can it effectively coordinate?</p><small>ORCHESTRATION</small></li>
        <li><span>03</span><p>Can an intelligence discover possibilities its existing imagination and models aren't capable of simulating yet?</p><small>BEYOND THE MODEL</small></li>
      </ol>
    </div>
  </section>
  <section class="closing shell" aria-labelledby="closing-title">
    <p class="side-index">A QUESTION, NOT A CONCLUSION</p>
    <h2 id="closing-title">What if the greatest expansion of intelligence doesn't come from knowing more things, but from developing <em>new ways of seeing what things can become?</em></h2>
    <p>I don't know where this framework ends. That's part of why I want to keep following it.</p>
    <div class="related"><a href="/clear.html">← How I See It</a><a href="#narrative">Experience the cycle again ↑</a></div>
  </section>
</main>
<footer><span>ICY CLEAR / GENERATIVE REALITY</span><span>AN EVOLVING LENS, NOT A DOCTRINE</span><a href="/">RETURN HOME ↗</a></footer>
<script is:inline>
  (function(){
    var sections=Array.from(document.querySelectorAll('.chapter'));
    var num=document.querySelector('[data-stage-number]');
    var note=document.querySelector('[data-stage-note]');
    var notes={
      perception:'The passage exists. I have not seen it yet.',
      recognition:'The passage becomes visible. Nothing physical had to be built.',
      simulation:'Several crossings appear as projections, not yet as facts.',
      orchestration:'One projected route takes physical form.',
      transformation:'A place that was unreachable can now be reached.',
      generativity:'New routes grow beyond the original plan.'
    };
    function update(){
      var middle=window.innerHeight*.53, best=sections[0],dist=Infinity;
      for(var i=0;i<sections.length;i++){
        var rect=sections[i].getBoundingClientRect();
        var d=rect.top<=middle&&rect.bottom>=middle?0:Math.min(Math.abs(rect.top-middle),Math.abs(rect.bottom-middle));
        if(d<dist){best=sections[i];dist=d;}
      }
      var scene=best.dataset.scene;
      if(document.documentElement.dataset.scene!==scene){
        document.documentElement.dataset.scene=scene;
        var ix=sections.indexOf(best)+1;
        if(num)num.textContent=String(ix).padStart(2,'0')+' / 06';
        if(note)note.textContent=notes[scene]||'';
      }
    }
    var scheduled=false;
    function schedule(){if(scheduled)return;scheduled=true;requestAnimationFrame(function(){scheduled=false;update();});}
    window.addEventListener('scroll',schedule,{passive:true});
    window.addEventListener('resize',schedule);
    update();
  })();
</script>
<style is:global>
