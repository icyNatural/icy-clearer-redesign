  .hero-tail{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:25px;margin-top:auto;color:#b8c7c4}.hero-tail a{border-bottom:1px solid var(--gold);padding-bottom:9px;color:var(--ink)}.hero-tail a span{margin-left:18px}
