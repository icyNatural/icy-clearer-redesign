---
import '../styles/philosophy-family.css';
import '../styles/generative-reality.css';
import PhilosophyHeader from '../components/philosophy/PhilosophyHeader.astro';
import PhilosophyFooter from '../components/philosophy/PhilosophyFooter.astro';
import { generativeStages } from '../data/philosophy-family';
---

<!doctype html>
<html lang="en" data-scene="perception">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#070c10" />
    <title>Generative Reality — How I See More | ICY CLEAR</title>
    <meta
      name="description"
      content="A personal spatial essay exploring six connected processes: Perception, Recognition, Simulation, Orchestration, Transformation, and Generativity."
    />
    <meta property="og:title" content="Generative Reality — How I See More | ICY CLEAR" />
    <meta
      property="og:description"
      content="Sometimes you expand your resolution of possibility. Once you act, you begin changing what actually becomes possible."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/clear/fonts/bodoni.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/clear/fonts/bodoni-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/clear/fonts/barlow.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/clear/fonts/plex-mono.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body class="ph-doc">
    <a href="#narrative" class="ph-skip">Skip to the six transitions</a>

    <PhilosophyHeader active="generative" />

    <main id="main">
      <!-- ── HERO ────────────────────────────────────────────────────────── -->
      <section class="gr-hero" aria-labelledby="hero-title">
        <div class="ph-shell gr-hero__inner">
          <p class="ph-mono gr-hero__kicker">
            HOW I SEE MORE <span>—</span> A PERSONAL FRAMEWORK IN MOTION
          </p>
          <h1 class="gr-hero__title" id="hero-title">
            Generative<br /><em>Reality.</em>
          </h1>
          <p class="gr-hero__lead">
            I keep investigating how much more I might see — not simply by accumulating facts,
            but by learning to recognize what things <em>could become</em> and what acting changes.
          </p>

          <nav class="gr-hero__arc" aria-label="Jump directly to any of the six stages">
            {generativeStages.map((stage, idx) => (
              <>
                {idx > 0 && <span class="gr-hero__arc-sep" aria-hidden="true">→</span>}
                <a href={`#${stage.id}`}>
                  <small>{stage.number}</small>
                  {stage.title}
                </a>
              </>
            ))}
          </nav>

          <div class="gr-hero__tail">
            <a class="gr-hero__cta" href="#narrative">
              Enter the changing environment <span aria-hidden="true">↓</span>
            </a>
            <p class="gr-hero__note">One architectural world · 06 spatial transitions</p>
          </div>
        </div>
      </section>

      <!-- ── OPENING FRAMING ─────────────────────────────────────────────── -->
      <section class="gr-opening" aria-labelledby="opening-title">
        <div class="ph-shell gr-opening__grid">
          <p class="ph-mono gr-side-index">BEFORE THE SEQUENCE / 00</p>
          <div>
            <h2 id="opening-title">
              Seeing more is not the same event as <em>making more possible.</em>
            </h2>
            <p class="gr-opening__lead">
              Sometimes a possibility was already carved into reality, and my angle or attention simply hadn’t resolved it yet.
              Other times, coordinating real tools and effort alters the environment so a new capability actually exists.
            </p>
            <p class="gr-opening__quiet">
              What follows is my own evolving inquiry — not a fixed scientific hierarchy of intelligence,
              and not a claim that imagination alone bends the physical world. Watch one environment change
              meaning as perception, recognition, simulation, orchestration, transformation, and generativity unfold.
            </p>
          </div>
        </div>
      </section>

      <!-- ── SIX-STAGE REAL 3D ARCHITECTURAL TRANSITION ──────────────────── -->
      <div id="narrative" class="gr-narrative" aria-label="Six connected processes in one evolving 3D world">
        <div class="gr-stage" data-gr-stage data-webgl="loading">
          <div class="gr-canvas-wrap" data-gr-canvas-wrap aria-hidden="true"></div>

          <!-- Architectural SVG Fallback if WebGL is unavailable -->
          <div class="gr-fallback" aria-hidden="true">
            <svg viewBox="0 0 880 420" fill="none">
              <defs>
                <linearGradient id="fbSky" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#10222b" />
                  <stop offset="100%" stop-color="#060c11" />
                </linearGradient>
                <linearGradient id="fbBeam" x1="0" y1="0" x2="1" y2="0.4">
                  <stop offset="0%" stop-color="#f2c87e" stop-opacity="0.42" />
                  <stop offset="100%" stop-color="#f2c87e" stop-opacity="0" />
                </linearGradient>
              </defs>
              <rect width="880" height="420" fill="url(#fbSky)" />
              <!-- Near bank & Far bank -->
              <polygon points="40,295 340,295 340,380 40,380" fill="#182730" stroke="#5f8692" stroke-opacity="0.4" />
              <polygon points="520,275 840,275 840,380 520,380" fill="#1d2f38" stroke="#5f8692" stroke-opacity="0.4" />
              <!-- Mid-canyon natural pier -->
              <rect x="412" y="315" width="38" height="70" fill="#131f27" stroke="#5f8692" stroke-opacity="0.35" />
              <!-- Monolith with pre-existing carved passage -->
              <rect x="195" y="135" width="70" height="160" fill="#1e303a" stroke="#6d95a1" stroke-opacity="0.45" />
              <rect x="218" y="185" width="26" height="110" fill="#091319" />
              <!-- Recognition seam + raking beam -->
              <rect class="fb-seam" x="218" y="185" width="26" height="110" stroke="#f2ca82" stroke-width="2" />
              <polygon class="fb-beam" points="244,185 375,260 355,310 244,295" fill="url(#fbBeam)" />
              <!-- Simulation ghost routes -->
              <g class="fb-ghosts">
                <path d="M340,292 Q430,210 520,275" stroke="#8ad3ef" stroke-width="1.5" stroke-dasharray="6 5" />
                <path d="M340,292 L520,275" stroke="#f2ca82" stroke-width="2" stroke-dasharray="5 4" />
                <path d="M340,292 Q435,322 520,275" stroke="#9fd9c4" stroke-width="1.5" stroke-dasharray="6 5" />
              </g>
              <!-- Orchestration solid bridge -->
              <g class="fb-bridge">
                <rect x="424" y="286" width="14" height="32" fill="#3a525c" stroke="#d9b16c" />
                <polygon points="336,294 524,274 524,288 336,306" fill="#3b535e" stroke="#e4ba75" stroke-width="1.6" />
              </g>
              <!-- Transformation arrival illumination -->
              <ellipse class="fb-arrival" cx="620" cy="272" rx="76" ry="18" fill="#a8d5c2" fill-opacity="0.28" stroke="#a8d5c2" />
              <!-- Generativity branching unplanned futures -->
              <g class="fb-branches">
                <path d="M620,272 Q705,215 805,180" stroke="#a9dec7" stroke-width="2.5" />
                <path d="M620,272 Q725,255 835,232" stroke="#e6c280" stroke-width="2.2" />
                <path d="M620,272 Q710,295 815,318" stroke="#9dcfe4" stroke-width="2" />
                <rect x="772" y="128" width="44" height="58" stroke="#a9dec7" stroke-width="2" />
              </g>
            </svg>
          </div>

          <div class="gr-stage__scrim" aria-hidden="true"></div>

          <div class="gr-stage__chrome">
            <span class="gr-stage__badge" data-gr-stage-badge>ACTUAL: PRESENT · PERCEIVED: UNSEEN</span>
            <span class="gr-stage__state" data-gr-stage-state>Initial vantage · stone unchanged</span>
          </div>

          <div class="gr-stage__caption" aria-live="polite">
            <div class="gr-stage__caption-top">
              <span class="gr-stage__num" data-gr-stage-num>01 / 06</span>
              <span class="gr-stage__track" aria-hidden="true">
                <span class="gr-stage__fill" data-gr-progress-fill></span>
              </span>
            </div>
            <p class="gr-stage__note" data-gr-stage-note>
              The passage is already carved into the stone. From this angle, it still looks like a wall.
            </p>
          </div>

          <!-- Desktop Right Navigation Rail -->
          <nav class="gr-rail" aria-label="Jump to stage in 3D sequence">
            {generativeStages.map((stage, idx) => (
              <button
                type="button"
                class:list={['gr-rail__btn', { 'is-active': idx === 0 }]}
                data-gr-jump={idx}
                aria-current={idx === 0 ? 'step' : 'false'}
              >
                <span>{stage.number} {stage.title}</span>
                <span class="gr-rail__pip" aria-hidden="true"></span>
              </button>
            ))}
          </nav>

          <!-- Mobile Touch Stage Pills -->
          <nav class="gr-mobile-pills" aria-label="Select transition stage">
            {generativeStages.map((stage, idx) => (
              <button
                type="button"
                class:list={[{ 'is-active': idx === 0 }]}
                data-gr-jump={idx}
                aria-current={idx === 0 ? 'step' : 'false'}
              >
                {stage.number} {stage.title}
              </button>
            ))}
          </nav>
        </div>

        <div class="gr-chapters">
          {generativeStages.map((stage, idx) => (
            <section
              class:list={['gr-chapter', { 'is-active': idx === 0 }]}
              id={stage.id}
              data-scene={stage.id}
              style={`--stage-accent:${stage.accent}`}
              aria-labelledby={`${stage.id}-title`}
            >
              <article class="gr-chapter__card">
                <p class="gr-chapter__kicker">{stage.number} / 06 — {stage.eyebrow}</p>
                <h2 class="gr-chapter__title" id={`${stage.id}-title`}>
                  {stage.title}<span>.</span>
                </h2>
                <blockquote class="gr-chapter__quote">{stage.statement}</blockquote>
                <p class="gr-chapter__copy">{stage.copy}</p>
                <div class="gr-chapter__foot">
                  <span>{stage.worldState}</span>
                  <span>{idx < generativeStages.length - 1 ? `Next: ${generativeStages[idx + 1].title} ↓` : 'Cycle complete ↓'}</span>
                </div>
              </article>
            </section>
          ))}
        </div>
      </div>

      <!-- ── THE CRUCIAL DISTINCTION: PERCEIVED VS ACTUAL AFFORDANCES ────── -->
      <section class="gr-affordances" id="affordances" aria-labelledby="affordance-title">
        <div class="ph-shell">
          <div class="gr-affordances__head">
            <p class="ph-mono gr-side-index">THE TURN / SEEN ≠ MADE</p>
            <div>
              <h2 id="affordance-title">
                The difference between<br /><em>an opening</em> and <em>a bridge.</em>
              </h2>
            </div>
          </div>

          <!-- Interactive Architectural Cross-Section Plate -->
          <div class="gr-plate" data-affordance-plate data-aff-state="perceived">
            <div class="gr-plate__controls" role="group" aria-label="Compare unseen, perceived, and actual affordances">
              <button type="button" class="gr-plate__btn" data-aff-mode="unseen" aria-pressed="false">
                <span>00 · Initial Encounter</span>
                <strong>Unseen Possibility</strong>
              </button>
              <button type="button" class="gr-plate__btn is-active" data-aff-mode="perceived" aria-pressed="true">
                <span>01 · Resolution Shifts</span>
                <strong>Perceived Affordance</strong>
              </button>
              <button type="button" class="gr-plate__btn" data-aff-mode="actual" aria-pressed="false">
                <span>02 · Action Changes World</span>
                <strong>Actual Affordance</strong>
              </button>
            </div>

            <div class="gr-plate__stage">
              <div class="gr-plate__svg-wrap">
                <svg class="gr-plate__svg" viewBox="0 0 640 270" fill="none" role="img" aria-label="Architectural cross-section demonstrating the difference between recognizing an existing stone opening and physically constructing a bridge">
                  <defs>
                    <linearGradient id="apGoldBeam" x1="0" y1="0" x2="1" y2="0.45">
                      <stop offset="0%" stop-color="#f2c87e" stop-opacity="0.46" />
                      <stop offset="100%" stop-color="#f2c87e" stop-opacity="0" />
                    </linearGradient>
                  </defs>

                  <!-- Subtle coordinate baseline -->
                  <line x1="20" y1="234" x2="620" y2="234" stroke="rgba(168,198,204,0.16)" stroke-dasharray="3 4" />
                  <text x="24" y="254" fill="#6f858b" font-family="ClearMono, monospace" font-size="9" letter-spacing="1.4">NEAR PLATEAU</text>
                  <text x="275" y="254" fill="#6f858b" font-family="ClearMono, monospace" font-size="9" letter-spacing="1.4">CHASM</text>
                  <text x="458" y="254" fill="#6f858b" font-family="ClearMono, monospace" font-size="9" letter-spacing="1.4">FAR TERRACE</text>

                  <!-- FIXED PHYSICAL STONE GEOMETRY (never changes between Unseen & Perceived!) -->
                  <polygon points="20,178 242,178 242,234 20,234" fill="#17242c" stroke="#537582" stroke-opacity="0.45" />
                  <polygon points="418,164 620,164 620,234 418,234" fill="#17252d" stroke="#537582" stroke-opacity="0.45" />
                  <!-- Mid-canyon outcrop -->
                  <rect x="316" y="192" width="28" height="42" fill="#121d24" stroke="#537582" stroke-opacity="0.4" />

                  <!-- Fixed Monolith with pre-existing carved passage -->
                  <rect x="130" y="64" width="54" height="114" fill="#1d2f39" stroke="#6e96a3" stroke-opacity="0.55" />
                  <rect x="148" y="106" width="18" height="72" fill="#071016" />

                  <!-- Recognition: light beam & highlighted inner stone edges (ZERO rock moved!) -->
                  <polygon class="ap-beam" points="166,106 312,174 282,196 166,178" fill="url(#apGoldBeam)" />
                  <rect class="ap-seam-glow" x="148" y="106" width="18" height="72" stroke="#f2ca82" stroke-width="2" />
                  <line class="ap-sightline" x1="88" y1="142" x2="412" y2="156" stroke="#9dcfe4" stroke-width="1.2" stroke-dasharray="4 4" />

                  <!-- Observer eye position -->
                  <circle cx="80" cy="142" r="5" fill="#9dcfe4" />
                  <circle cx="80" cy="142" r="11" stroke="#9dcfe4" stroke-opacity="0.45" />

                  <!-- Actual Affordance change: real load-bearing bridge & newly reachable far ridge -->
                  <g class="ap-bridge">
                    <rect x="324" y="172" width="12" height="22" fill="#3a525c" stroke="#e4ba75" />
                    <polygon points="238,176 422,162 422,172 238,186" fill="#364f5a" stroke="#e4ba75" stroke-width="1.6" />
                  </g>
                  <ellipse class="ap-far-lit" cx="496" cy="162" rx="54" ry="10" fill="#a8d5c2" fill-opacity="0.28" stroke="#a8d5c2" />
                  <g class="ap-new-horizon">
                    <path d="M496,162 Q546,120 612,98" stroke="#a8d5c2" stroke-width="1.8" />
                    <path d="M496,162 Q554,144 614,136" stroke="#e4ba75" stroke-width="1.5" stroke-dasharray="4 3" />
                    <circle cx="612" cy="98" r="3.5" fill="#a8d5c2" />
                  </g>
                </svg>
              </div>

              <div class="gr-plate__readout" aria-live="polite">
                <p class="gr-plate__status" data-aff-status>01 · RESOLUTION SHIFTED (PERCEIVED AFFORDANCE)</p>
                <div class="gr-plate__metrics">
                  <div class="gr-plate__metric">
                    <span>Physical Reality</span>
                    <strong data-aff-physical>Identical stone · Zero physical change</strong>
                  </div>
                  <div class="gr-plate__metric">
                    <span>What Changed</span>
                    <strong data-aff-perceived>Hidden passage recognized</strong>
                  </div>
                </div>
                <p class="gr-plate__desc" data-aff-desc>
                  Notice that every stone wall coordinate stayed completely fixed. Only raking light and angle shifted — expanding your resolution of what was already there.
                </p>
              </div>
            </div>
          </div>

          <!-- Required verbatim conceptual distinction -->
          <div class="gr-distinction-passage">
            <p class="ph-mono gr-side-index">RESOLUTION VS. CHANGE</p>
            <div>
              <blockquote class="gr-turning-quote">
                “You might not be expanding reality every time you discover something. You may be expanding your{' '}
                <em>resolution of possibility</em>—your ability to recognize what was already there.”
              </blockquote>
              <p class="gr-turning-followup">
                But once you act on those discoveries, you can begin changing what actually becomes possible.
              </p>

              <div class="gr-contrast-cards">
                <article class="gr-contrast-item">
                  <span>Perceived Affordance</span>
                  <h3>Seeing what was already there</h3>
                  <p>
                    An opening may exist long before I notice it. Recognizing it changes my access to information and what I know I can attempt — without altering the physical terrain itself.
                  </p>
                </article>
                <article class="gr-contrast-item gr-contrast-item--actual">
                  <span>Actual Affordance</span>
                  <h3>Changing what becomes available</h3>
                  <p>
                    An actual affordance is an action genuinely available through the relationship between an agent and an environment. Orchestrating a real bridge changes the world so previously impossible crossings become feasible.
                  </p>
                </article>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── OPEN QUESTIONS ON MINERAL PAPER ─────────────────────────────── -->
      <section class="gr-questions" id="questions" aria-labelledby="questions-title">
        <div class="ph-shell">
          <p class="ph-mono gr-side-index">OPEN INQUIRY / QUESTIONS I AM STILL FOLLOWING</p>
          <h2 id="questions-title">
            What does intelligence<br /><em>make visible — and possible?</em>
          </h2>

          <ol class="gr-q-list">
            <li>
              <span class="gr-q-num">01</span>
              <p class="gr-q-text">
                How much of the <em>possible</em> can an intelligence mentally explore, and how much of the <em>actual</em> can it effectively coordinate?
              </p>
              <span class="gr-q-tag">Simulation ⇄ Orchestration</span>
            </li>
            <li>
              <span class="gr-q-num">02</span>
              <p class="gr-q-text">
                Can an intelligence discover possibilities that its existing imagination and models aren't even capable of simulating yet?
              </p>
              <span class="gr-q-tag">Beyond the model</span>
            </li>
          </ol>
        </div>
      </section>

      <!-- ── CONCLUDING INQUIRY ──────────────────────────────────────────── -->
      <section class="gr-closing" aria-labelledby="closing-title">
        <div class="ph-shell">
          <p class="ph-mono gr-side-index">A QUESTION, NOT A CONCLUSION</p>
          <h2 class="gr-closing__title" id="closing-title">
            What if the greatest expansion of intelligence doesn't come from knowing more things, but from developing{' '}
            <em>new ways of seeing what things can become?</em>
          </h2>
          <p class="gr-closing__note">
            I don’t know where this inquiry ends — and I don’t want to close it into a settled doctrine.
            Every stage here stays open to better ways of looking.
          </p>

          <div class="gr-closing__actions">
            <a href="/clear.html">← How I See It · ICY CLEAR</a>
            <a href="/models/seeing-before-naming.html">M-01 Seeing Before Naming ↗</a>
            <a href="#narrative">Experience the six transitions again ↑</a>
          </div>
        </div>
      </section>
    </main>

    <PhilosophyFooter active="generative" />

    <script src="../scripts/generative-reality-scene.ts"></script>
  </body>
</html>
